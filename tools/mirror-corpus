#!/usr/bin/env python3
"""mirror-corpus - capture one window three ways, at one moment, and diff them.

WHY THREE READS AND NOT TWO.

The Mirror renders from the scene IR; so does MCP. If the guest's own walk
never captured a list's cells, both faces are equally blind and comparing them
proves nothing -- the wall this project keeps hitting lives one layer below
either of them. So a capture takes three independent reads of the same window:

  frame   the guest framebuffer, over QMP        -- what the machine SHOWS
  ir      now_mirror_snapshot, over the agent    -- what the IR CARRIES
  guest   the harness's own observe, over TCP    -- what the guest's own
                                                    structures HOLD

and two diffs fall out, answering different questions:

  frame vs ir     what we fail to show    -- the UX gap, scored by eye until now
  ir   vs guest   WHICH LAYER lost it     -- the structure was there and the
                                             producer dropped it, or it was
                                             never there at all

Without the second diff an enumeration is a list of complaints. With it, every
row arrives already assigned to producer work, honesty work, or
deferred-forever.

The `guest` read is deliberately the harness and not a QEMU memory read. Both
are oracles and they have different jobs: memory DISCOVERS layout, one-off,
when nobody yet knows what a structure looks like -- and the harness SURVEYS
coverage, over the wire, ON METAL. If surveying depended on the emulator the
coverage question would be unanswerable on the PowerBook, which is the one
machine where it matters. Rows where the harness ALSO sees nothing are the ones
that earn a memory-discovery pass later.

THREE RULES THIS TOOL ENFORCES rather than asking anyone to remember:

  one moment      the machine moves between reads, and a diff across two states
                  is noise wearing the costume of a finding. Captures carry
                  their skew and refuse past --max-skew.
  provenance      guest build, resident build, plane bits and snapshot id, on
                  EVERY capture and not once per session -- the plane mask was
                  observed flapping between 7 and 15 within one session on
                  2026-08-05, so a session-level premise would have been false
                  for half its own captures.
  garbage and all the corpus keeps corrupt titles, unavailable coverage and
                  stale rows. A corpus of only healthy scenes tests nothing
                  (archive/mirror-standalone-2026-08-09/AGENTS.md).

    tools/mirror-corpus capture date-and-time
    tools/mirror-corpus ledger
"""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
LAB = Path(os.environ.get("NOW_LAB_ROOT", REPO.parent))
DEFAULT_ROOT = REPO / "docs" / "local" / "corpus"


def now_agent(*args: str) -> dict:
    """One call through the same socket an MCP client uses."""
    out = subprocess.run([str(REPO / "tools" / "now-agent"), *args, "--json"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        raise SystemExit(f"now-agent {' '.join(args)} failed:\n{out.stderr}")
    return json.loads(out.stdout)


def hc(*args: str, port: int) -> dict:
    """The guest harness's own view -- an independent path to the same
    structures, which is the whole point of reading it."""
    out = subprocess.run([str(LAB / "tools" / "hc"), *args,
                          "--host", "127.0.0.1", "--port", str(port)],
                         capture_output=True, text=True, cwd=str(LAB))
    for line in out.stdout.splitlines():
        if line.startswith("recv: "):
            return json.loads(line[len("recv: "):])
    raise SystemExit(f"hc {' '.join(args)} gave no reply:\n{out.stdout}")


def screendump(qmp: Path, target: Path) -> None:
    subprocess.run([str(LAB / "tools" / "qmp"), str(qmp), "screendump",
                    json.dumps({"filename": str(target)})],
                   capture_output=True, text=True, check=True)
    png = target.with_suffix(".png")
    subprocess.run(["sips", "-s", "format", "png", str(target),
                    "--out", str(png)], capture_output=True, check=True)


def capture(args) -> int:
    root = Path(args.root) / args.slug
    root.mkdir(parents=True, exist_ok=True)
    marks = {}

    def mark(name):
        marks[name] = time.time()

    # Ordered cheapest-last so the expensive reads bracket as tightly as they
    # can; the skew is reported either way rather than assumed small.
    mark("t0")
    guest = hc("observe", port=args.harness_port)
    mark("guest")
    ir = now_agent("mirror_read", "--intention", "snapshot")
    mark("ir")
    screendump(Path(args.qmp), root / "frame.ppm")
    mark("frame")
    life = now_agent("mirror_read", "--intention", "lifecycle")
    mark("provenance")

    skew = marks["provenance"] - marks["t0"]
    (root / "guest.json").write_text(json.dumps(guest, indent=2))
    (root / "ir.json").write_text(json.dumps(ir, indent=2))
    (root / "lifecycle.json").write_text(json.dumps(life, indent=2))

    lv = (life.get("mirrorReadResult") or {}).get("value") or {}
    lifecycle = lv.get("lifecycle") or {}
    iv = (ir.get("mirrorReadResult") or {}).get("value") or {}
    meta = (iv.get("snapshot") or {}).get("metadata") or {}
    manifest = {
        "schema": "now-mirror-corpus/v1",
        "slug": args.slug,
        "capturedAt": marks["t0"],
        "skewSeconds": round(skew, 3),
        # A capture whose reads straddle a machine change is not a finding.
        "valid": skew <= args.max_skew,
        "maxSkewSeconds": args.max_skew,
        "provenance": {
            "guest": meta.get("guest"),
            "session": meta.get("session"),
            "snapshotID": meta.get("snapshotID"),
            "sequence": meta.get("sequence"),
            "sceneGeneration": meta.get("sceneGeneration"),
            "contentGeneration": meta.get("contentGeneration"),
            "residentBuild": lifecycle.get("residentBuild"),
            "residentLifecycle": lifecycle.get("lifecycle"),
            "capabilities": lifecycle.get("capabilities"),
            "requested": lifecycle.get("requested"),
            "active": lifecycle.get("active"),
            "planeGenerations": {
                p["id"]: p["generation"] for p in lifecycle.get("planes", [])
            },
        },
    }
    (root / "manifest.json").write_text(json.dumps(manifest, indent=2))
    state = "ok" if manifest["valid"] else "INVALID (skew)"
    print(f"{args.slug}: {state}  skew {skew:.2f}s  "
          f"snapshot {meta.get('snapshotID')}  "
          f"planes req={lifecycle.get('requested')} "
          f"act={lifecycle.get('active')}")
    return 0 if manifest["valid"] else 1


def ir_windows(ir: dict) -> list:
    value = (ir.get("mirrorReadResult") or {}).get("value") or {}
    return ((value.get("snapshot") or {}).get("surfaces")) or []


def guest_windows(guest: dict) -> list:
    return (guest.get("result") or {}).get("windows") or []


def ledger(args) -> int:
    root = Path(args.root)
    rows = []
    for slug in sorted(p.name for p in root.iterdir() if p.is_dir()):
        d = root / slug
        try:
            manifest = json.loads((d / "manifest.json").read_text())
            ir = json.loads((d / "ir.json").read_text())
            guest = json.loads((d / "guest.json").read_text())
        except FileNotFoundError:
            continue
        surfaces = ir_windows(ir)
        gwins = guest_windows(guest)
        ir_items = sum(s["itemTotal"] for s in surfaces)
        ir_kinds = {}
        addressable = 0
        for s in surfaces:
            for i in s["items"]:
                ir_kinds[i.get("kind") or "?"] = \
                    ir_kinds.get(i.get("kind") or "?", 0) + 1
                if i.get("ref"):
                    addressable += 1
        guest_controls = sum(len(w.get("controls") or []) for w in gwins)
        rows.append({
            "slug": slug,
            "valid": manifest.get("valid"),
            "irWindows": len(surfaces),
            "guestWindows": len(gwins),
            "irItems": ir_items,
            "guestControls": guest_controls,
            "addressable": addressable,
            "kinds": ir_kinds,
            "provenance": manifest.get("provenance", {}),
        })

    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    print(f"{'panel':<22} {'ok':<5} {'win ir/guest':<13} "
          f"{'items ir/guest':<15} {'addressable':<12} kinds")
    for r in rows:
        kinds = ", ".join(f"{k}:{v}" for k, v in
                          sorted(r["kinds"].items(), key=lambda kv: -kv[1]))
        print(f"{r['slug']:<22} {str(bool(r['valid'])):<5} "
              f"{str(r['irWindows'])+'/'+str(r['guestWindows']):<13} "
              f"{str(r['irItems'])+'/'+str(r['guestControls']):<15} "
              f"{str(r['addressable'])+'/'+str(r['irItems']):<12} "
              f"{kinds[:60]}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", default=str(DEFAULT_ROOT))
    sub = parser.add_subparsers(dest="command", required=True)

    cap = sub.add_parser("capture", help="three reads of the current state")
    cap.add_argument("slug")
    cap.add_argument("--qmp", default=str(LAB / "run" / "qmp.sock"))
    cap.add_argument("--harness-port", type=int, default=1400)
    cap.add_argument("--max-skew", type=float, default=3.0)
    cap.set_defaults(func=capture)

    led = sub.add_parser("ledger", help="the gap table across captures")
    led.add_argument("--json", action="store_true")
    led.set_defaults(func=ledger)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
