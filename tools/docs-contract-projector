#!/usr/bin/env python3
"""Project NOW's AsyncAPI document into deterministic Markdown.

The official AsyncAPI generator is useful as a compatibility probe, but its
current dependency graph is too large and vulnerable to put in the required
landing gate. This projector reads the same standard document, validates every
local reference through tools/docs-gate, and emits the tables NOW actually
needs, including the project-specific x-commands registry official templates
do not render.
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import re
import sys

import yaml


def root() -> Path:
    value = os.environ.get("NOW_DOCS_GATE_ROOT")
    return Path(value).resolve() if value else Path(__file__).resolve().parent.parent


def one_line(value: object) -> str:
    return " ".join(str(value or "").split())


def ref_name(value: object) -> str:
    if isinstance(value, dict):
        ref = value.get("$ref")
        if isinstance(ref, str):
            return ref.rsplit("/", 1)[-1]
    return "—"


def message_names(operation: dict) -> str:
    return ", ".join(f"`{ref_name(message)}`" for message in operation.get("messages", [])) or "—"


def argument_names(command: dict) -> str:
    args = command.get("args", {})
    if not isinstance(args, dict):
        return "—"
    properties = args.get("properties") if args.get("type") == "object" else args
    if not isinstance(properties, dict):
        return "—"
    required = set(args.get("required", []))
    names = []
    for name in properties:
        suffix = " (required)" if name in required else ""
        names.append(f"`{name}`{suffix}")
    return ", ".join(names) or "—"


def output_names(command: dict) -> str:
    output = command.get("output", {})
    if not isinstance(output, dict):
        return "—"
    properties = output.get("properties", {})
    return ", ".join(f"`{name}`" for name in properties) or "—"


def render(document: dict) -> str:
    info = document.get("info", {})
    messages = document.get("components", {}).get("messages", {})
    commands = document.get("components", {}).get("x-commands", {})
    lines = [
        "<!-- now-doc-provenance: generated reviewed=false -->",
        "",
        "# Generated wire contract reference",
        "",
        "<!-- Generated by tools/docs-contract-projector; do not edit. -->",
        "",
        "This reference is projected from [`contract/asyncapi.yaml`](../developer-guide/architecture/wire-contract.md). "
        "The contract file remains normative. NOW's eight-byte binary frame is normative prose in that file because AsyncAPI describes messages, not this custom framing layer.",
        "",
        f"- AsyncAPI version: `{document.get('asyncapi')}`",
        f"- Product contract version: `{info.get('version')}`",
        f"- Contract revision: `{info.get('x-contract-revision')}`",
        f"- Default content type: `{document.get('defaultContentType')}`",
        "",
        "## Channels",
        "",
        "| ID | Address | Purpose |",
        "|---|---:|---|",
    ]
    for channel_id, channel in document.get("channels", {}).items():
        lines.append(f"| `{channel_id}` | `{channel.get('address')}` | {one_line(channel.get('description'))} |")
    lines.extend(["", "## Operations", "", "| Operation | Direction | Channel | Messages |", "|---|---|---|---|"])
    for operation_id, operation in document.get("operations", {}).items():
        lines.append(
            f"| `{operation_id}` | `{operation.get('action')}` | `{ref_name(operation.get('channel'))}` | {message_names(operation)} |"
        )
    lines.extend(["", "## Messages", "", "| Registry ID | Wire name | Payload schema |", "|---|---|---|"])
    for message_id, message in messages.items():
        lines.append(f"| `{message_id}` | `{message.get('name')}` | `{ref_name(message.get('payload'))}` |")
    lines.extend([
        "",
        "## Commands",
        "",
        "Commands are a NOW extension under `components.x-commands`. The receiver owns the grammar and behavior; the sender treats the name and arguments as contract data.",
        "",
        "| Command | Arguments | Output keys | Summary |",
        "|---|---|---|---|",
    ])
    for name, command in commands.items():
        if not isinstance(command, dict) or not command.get("description"):
            continue
        summary = re.split(r"(?<=[.!?])\s+", one_line(command.get("description")), maxsplit=1)[0]
        lines.append(f"| `{name}` | {argument_names(command)} | {output_names(command)} | {summary} |")
    lines.extend([
        "",
        "## Change discipline",
        "",
        "A behavior change begins in the contract. Implement the receiving side's share on the host, PPC guest, and 68K guest where supported; state intentional asymmetry; then update conformance fixtures and re-run the documentation projection.",
        "",
    ])
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    repo = root()
    source = repo / "contract/asyncapi.yaml"
    target = repo / "docs/generated/asyncapi.md"
    expected = render(yaml.safe_load(source.read_text()))
    actual = target.read_text() if target.exists() else None
    if args.check:
        if actual != expected:
            print("docs-contract-projector: generated reference is stale", file=sys.stderr)
            print("Run: scripts/docs-contract", file=sys.stderr)
            return 1
        print("docs-contract-projector: generated reference is current")
        return 0
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(expected)
    print("docs-contract-projector: wrote docs/generated/asyncapi.md")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
