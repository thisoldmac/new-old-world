#!/usr/bin/env python3
"""What the mirror actually sent, and what came back.

    tools/mirror-acts [N]        # the last N acts, newest last (default 15)
    tools/mirror-acts --watch    # follow

Reads ~/Library/Logs/NewOldWorld/acts.log, which NOW writes at the one
choke point every act passes through.

WHY THIS EXISTS. Three different things look identical from a chair in
front of the mirror:

    the act never left          "I clicked and nothing happened"
    the act was refused         "I clicked and nothing happened"
    the act worked, slowly      "I clicked and nothing happened"

Each wants a different fix, and on 2026-08-03 a whole day of driving
could not tell them apart. A title-bar drag was scored broken, an icon
open was scored failed, and a modal alert was scored undismissable when
the click had in fact dismissed it. Every one of those was a guess.

This is a DIAGNOSTIC and not a test channel. It says what the driving
did; it never says whether the mirror works. That is still rule 1's
job - drive it, look at it, pair it against the machine.
"""

import os
import sys
import time

LOG = os.path.expanduser("~/Library/Logs/NewOldWorld/acts.log")


def main(argv):
    if not os.path.exists(LOG):
        sys.stderr.write(
            "no act log at %s\n"
            "NOW writes it as soon as the mirror dispatches its first act; "
            "an empty log after driving IS a finding - nothing was sent.\n"
            % LOG)
        return 1

    if "--watch" in argv:
        with open(LOG) as f:
            f.seek(0, os.SEEK_END)
            while True:
                line = f.readline()
                if line:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                else:
                    time.sleep(0.3)

    count = 15
    for a in argv:
        if a.isdigit():
            count = int(a)
    with open(LOG) as f:
        lines = f.read().splitlines()
    # Two physical lines per act: the outcome, then the action itself.
    records = ["\n".join(lines[i:i + 2]) for i in range(0, len(lines), 2)]
    for r in records[-count:]:
        print(r)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
