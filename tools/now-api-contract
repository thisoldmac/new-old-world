#!/usr/bin/env python3
"""Validate the NOW API authority and generate its checked Swift identities."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
CONTRACT = ROOT / "contract" / "now-api.openapi.json"
OUTPUT = ROOT / "now-host" / "Sources" / "NOWAgentIntegration" / "Projection" / "NOWAPIOperationIDs.generated.swift"
CLI_OUTPUT = ROOT / "now-cli" / "now_cli" / "_generated.py"
BASH_OUTPUT = ROOT / "now-cli" / "completion" / "now.bash"
ZSH_OUTPUT = ROOT / "now-cli" / "completion" / "_now"


def rendered(document: dict, digest: str) -> str:
    operations = document.get("x-now-operation-catalog")
    if not isinstance(operations, list) or not operations:
        raise ValueError("x-now-operation-catalog must be a non-empty array")
    if operations != sorted(set(operations)):
        raise ValueError("x-now-operation-catalog must be sorted and unique")
    if document.get("openapi") != "3.1.0":
        raise ValueError("openapi must be 3.1.0")
    if document.get("info", {}).get("version") != "1.0.0":
        raise ValueError("info.version must identify the first public API as 1.0.0")
    scheme = document.get("components", {}).get("securitySchemes", {}).get("apiKey", {})
    if scheme.get("type") != "apiKey" or scheme.get("name") != "X-API-Key":
        raise ValueError("v1 authentication must be the X-API-Key header")
    command_route = document.get("paths", {}).get(
        "/guests/{guestID}/commands", {}).get("post", {})
    if command_route.get("operationId") != "commands.execute":
        raise ValueError("commands.execute must bind POST /guests/{guestID}/commands")
    command_schema = command_route.get("requestBody", {}).get(
        "content", {}).get("application/json", {}).get("schema", {})
    if command_schema.get("$ref") != "#/components/schemas/ConsoleCommandRequest":
        raise ValueError("commands.execute must bind ConsoleCommandRequest")
    required_schemas = {
        "APIVersion", "GuestAddress", "OperationDisposition",
        "OperationError", "OperationResult", "GuestSummary",
        "ListenerStatus", "ConnectionSummary", "ConsoleCommandRequest",
        "ConsoleCommandDisposition", "ConsoleCommandResult", "TransferSummary",
        "PublicEventGuest", "PublicEvent",
        "GenericOperationInvocation", "GenericOperationResult",
    }
    schemas = set(document.get("components", {}).get("schemas", {}))
    missing = sorted(required_schemas - schemas)
    if missing:
        raise ValueError("missing core schemas: " + ", ".join(missing))
    reaches = document["components"]["schemas"]["OperationError"].get(
        "properties", {}).get("reach", {}).get("enum")
    expected_reaches = ["request", "host", "guest", "session", "resource",
                        "operation", "transfer"]
    if reaches != expected_reaches:
        raise ValueError(
            "OperationError reach must cover the runtime request, host, guest, "
            "session, resource, operation, and transfer boundaries")
    event_route = document.get("paths", {}).get("/events", {}).get("get", {})
    if event_route.get("operationId") != "events.watch":
        raise ValueError("events.watch must bind GET /events")
    event_description = event_route.get("description", "")
    if "Live-only" not in event_description or "refetch" not in event_description:
        raise ValueError("events.watch must state live-only refetch semantics")
    generic_route = document.get("paths", {}).get(
        "/operations/{operationID}", {}).get("post", {})
    if generic_route.get("operationId") != "operations.invoke":
        raise ValueError("generic public reach must bind POST /operations/{operationID}")
    schema_revision = document.get("x-now-compatibility", {}).get(
        "schemaRevision")
    if not isinstance(schema_revision, int) or schema_revision < 1:
        raise ValueError("x-now-compatibility.schemaRevision must be positive")
    quoted = ",\n".join(f'        "{operation}"' for operation in operations)
    return f'''// Generated by tools/now-api-contract. Do not edit.
import Foundation

public enum NOWAPIOperationIDs {{
    public static let apiMajor = 1
    public static let schemaRevision = {schema_revision}
    public static let contractDigest = "{digest}"
    public static let all: Set<String> = [
{quoted},
    ]
}}
'''


def rendered_cli(document: dict, digest: str) -> str:
    operations = document["x-now-operation-catalog"]
    metadata = document.get("x-now-cli-operation-metadata")
    if not isinstance(metadata, list) or not metadata:
        raise ValueError("x-now-cli-operation-metadata must describe generic CLI reach")
    metadata_ids = [row.get("operationId") for row in metadata
                    if isinstance(row, dict)]
    if metadata_ids != sorted(set(metadata_ids)):
        raise ValueError("CLI operation metadata must be sorted and unique")
    if not set(metadata_ids).issubset(operations):
        raise ValueError("CLI operation metadata contains a non-public operation")
    for row in metadata:
        if set(row) != {"operationId", "effect", "addressing", "rendering"}:
            raise ValueError("CLI operation metadata has an unknown or missing field")
        if row["rendering"] != "generic":
            raise ValueError("CLI operation metadata describes only generic reach")
    quoted = ",\n".join(f'    {operation!r}' for operation in operations)
    rendered_metadata = repr({row["operationId"]: {
        "effect": row["effect"], "addressing": row["addressing"],
        "rendering": row["rendering"]} for row in metadata})
    return f'''# Generated by tools/now-api-contract. Do not edit.
API_MAJOR = {document["x-now-compatibility"]["apiMajor"]}
SCHEMA_REVISION = {document["x-now-compatibility"]["schemaRevision"]}
CONTRACT_DIGEST = {digest!r}
OPERATION_IDS = frozenset((
{quoted},
))
OPERATION_METADATA = {rendered_metadata}
'''


CLI_DOMAINS = {
    "guests": ("list", "status", "use"),
    "connections": ("list", "start", "stop", "disconnect"),
    "console": (),
    "files": ("list", "stat", "mkdir", "move", "trash", "restore", "get", "put"),
    "transfers": ("list", "status", "cancel"),
    "events": ("watch",),
    "api": ("operations", "call"),
}


def rendered_bash(document: dict) -> str:
    domains = " ".join(CLI_DOMAINS)
    verbs = "\n".join(
        f'    {domain}) candidates="{" ".join(items)}" ;;'
        for domain, items in CLI_DOMAINS.items())
    operations = " ".join(
        row["operationId"] for row in document["x-now-cli-operation-metadata"])
    return f'''# Generated by tools/now-api-contract. Do not edit.
_now_complete() {{
  local cur="${{COMP_WORDS[COMP_CWORD]}}" prev="${{COMP_WORDS[COMP_CWORD-1]}}"
  local domains="{domains}" generic_operations="{operations}"
  local domain="" verb="" domain_index=-1 candidates="" i
  for ((i=1; i<COMP_CWORD; i++)); do
    case "${{COMP_WORDS[i]}}" in
      {"|".join(CLI_DOMAINS)})
        if [[ -z $domain ]]; then domain="${{COMP_WORDS[i]}}"; domain_index=$i
        elif [[ -z $verb ]]; then verb="${{COMP_WORDS[i]}}"
        fi ;;
      *) if [[ $domain_index -ge 0 && -z $verb && $i -eq $((domain_index+1)) ]]; then verb="${{COMP_WORDS[i]}}"; fi ;;
    esac
  done
  if [[ -z $domain ]]; then
    COMPREPLY=( $(compgen -W "$domains --endpoint --api-key --json --guest" -- "$cur") )
    return
  fi
  if [[ $COMP_CWORD -eq $((domain_index+1)) ]]; then
    case "$domain" in
{verbs}
    esac
    COMPREPLY=( $(compgen -W "$candidates" -- "$cur") )
    return
  fi
  if [[ $domain == api && $verb == call && $COMP_CWORD -eq $((domain_index+2)) ]]; then
    COMPREPLY=( $(compgen -W "$generic_operations" -- "$cur") )
    return
  fi
  if [[ $domain == files && $verb == put && $prev == --container ]]; then
    COMPREPLY=( $(compgen -W "data macbinary" -- "$cur") )
  fi
}}
complete -F _now_complete now
'''


def rendered_zsh(document: dict) -> str:
    domains = " ".join(CLI_DOMAINS)
    operations = " ".join(
        row["operationId"] for row in document["x-now-cli-operation-metadata"])
    verb_cases = "\n".join(
        f'    {domain}) candidates=({" ".join(items)}) ;;'
        for domain, items in CLI_DOMAINS.items())
    return f'''#compdef now
# Generated by tools/now-api-contract. Do not edit.
local -a domains generic_operations candidates
local domain="" verb="" domain_index=0 word i
domains=({domains})
generic_operations=({operations})
for ((i=2; i<CURRENT; i++)); do
  word="${{words[i]}}"
  if (( domain_index == 0 )) && (( $domains[(Ie)$word] )); then
    domain="$word"; domain_index=$i
  elif (( domain_index > 0 && i == domain_index + 1 )); then
    verb="$word"
  fi
done
if [[ -z $domain ]]; then
  _describe 'domain' domains
  return
fi
if (( CURRENT == domain_index + 1 )); then
  case "$domain" in
{verb_cases}
  esac
  _describe 'command' candidates
  return
fi
if [[ $domain == api && $verb == call ]] && (( CURRENT == domain_index + 2 )); then
  _describe 'operation' generic_operations
  return
fi
if [[ $domain == files && $verb == put && "${{words[CURRENT-1]}}" == --container ]]; then
  candidates=(data macbinary)
  _describe 'container' candidates
fi
'''


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    document = json.loads(CONTRACT.read_text())
    expected = rendered(document, hashlib.sha256(CONTRACT.read_bytes()).hexdigest())
    digest = hashlib.sha256(CONTRACT.read_bytes()).hexdigest()
    expected_cli = rendered_cli(document, digest)
    expected_bash = rendered_bash(document)
    expected_zsh = rendered_zsh(document)
    if args.check:
        outputs = [(OUTPUT, expected), (CLI_OUTPUT, expected_cli),
                   (BASH_OUTPUT, expected_bash), (ZSH_OUTPUT, expected_zsh)]
        if any(not path.exists() or path.read_text() != value
               for path, value in outputs):
            print(f"stale generated API identities: run {Path(__file__).relative_to(ROOT)}", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(expected)
    CLI_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    BASH_OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    CLI_OUTPUT.write_text(expected_cli)
    BASH_OUTPUT.write_text(expected_bash)
    ZSH_OUTPUT.write_text(expected_zsh)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
