@case("base: a resident older than this checkout's ext/ is named, with the commit")
def _(tmp):
    r = Repo(tmp, "bi5")
    img = os.path.join(tmp, "stage.qcow2")
    hfs_image(img, clean=True)
    # A receipt that describes exactly these bytes — so the image is
    # ACCOUNTED FOR, and the only thing wrong with it is its age. That is
    # 2026-08-06 in miniature: six ext/ commits landed after the bake and
    # every session cloned it anyway.
    r.receipts([receipt(r.digest(), img, sha_of(img),
                        at="2026-08-03T01:00:00-0400")])
    r.git("add", "--", "ext/stage-receipts.json")
    r.git("commit", "-qm", "receipt")
    r.write("ext/src/now_ext.c", "int resident(void) { return 42; }\n")
    r.git("add", "--", "ext/src/now_ext.c")
    r.git("commit", "-qm", "the resident work the image predates")
    env = {"NOW_STAGE_IMAGE": img}

    stale = base_image(r, "fit", img, "--purpose", "oracle", env=env)
    must(stale.returncode == 3,
         f"a stale resident with nothing staging a fresh one must refuse:\n"
         f"{stale.stdout}{stale.stderr}")
    must("ext/ has moved since" in stale.stderr, stale.stderr)
    must("the resident work the image predates" in stale.stderr,
         "name the commit, so the reader can judge it:\n" + stale.stderr)

    # MUTATION: the same image, a run that stages a fresh resident. Warns,
    # and must not refuse — spin-up-ppc is that run, on every lane.
    warn = base_image(r, "fit", img, "--purpose", "ppc-work",
                      "--stages-resident", env=env)
    must(warn.returncode == 0, warn.stdout + warn.stderr)


@case("base: which names the stage image, and no clone site hardcodes another")
def _(tmp):
    # THE 2026-08-07 DEFECT ITSELF. `scripts/spin-up-ppc` defaulted BASE to
    # os91-runner.qcow2 in one line, with a comment further down saying so,
    # and every lane in the arc cloned a 19 July image. A default that
    # disagrees with the designated base is not a bug you can read your way
    # out of — it has to be impossible to write.
    got = sh(sys.executable, os.path.join(ROOT, "tools", "base-image"), "which")
    must(got.returncode == 0, got.stdout + got.stderr)
    must(got.stdout.strip().endswith("now-mirror-stage.qcow2"),
         f"the designated PPC base must be the stage image: {got.stdout!r}")

    with open(os.path.join(ROOT, "scripts", "spin-up-ppc")) as fh:
        spin = [ln for ln in fh if ln.startswith("BASE=")]
    must(spin, "scripts/spin-up-ppc must still set BASE")
    must(all("os91-runner" not in ln for ln in spin),
         f"a clone site must not hardcode a base of its own: {spin}")
    must(any("base-image" in ln for ln in spin),
         f"the default must come from tools/base-image: {spin}")


@case("base: every clone site consults tools/base-image before cloning")
def _(tmp):
    # THE GATE THAT MAKES THIS THE LAST TIME. Each of the four failures was
    # one layer away from the last fix, and the reason a new layer keeps
    # appearing unguarded is that nothing enumerates the layers. This does:
    # a file that clones a disk image must also ask whether the base is fit.
    #
    # A grep, deliberately, and the same shape as CommandParityTests — the
    # alternative is a list somebody maintains by hand, which AGENTS.md has
    # already paid to learn rots at merges.
    clones, unguarded = [], []
    for sub in ("scripts", "tools"):
        d = os.path.join(ROOT, sub)
        for name in sorted(os.listdir(d)):
            path = os.path.join(d, name)
            if not os.path.isfile(path) or name in ("base-image",
                                                    "image-provenance",
                                                    "image-discipline-tests"):
                continue
            try:
                with open(path, errors="replace") as fh:
                    body = fh.read()
            except OSError:
                continue
            # WHAT THIS CAN SEE, said plainly, because a scan that
            # overstates its reach is worse than none: the shell idioms
            # this tree actually clones with. A future site that clones an
            # image from PYTHON — shutil.copy of a .qcow2, say — would
            # pass this scan while breaking the rule it enforces. If you
            # write one, add its idiom here in the same commit.
            if not any(k in body for k in ("tbt_clone_disk ", "clone_disk \"$BASE\"",
                                           "cp -c \"$BASE", "qemu-img create -b")):
                continue
            clones.append(name)
            if "base-image" not in body:
                unguarded.append(name)
    must(clones, "the scan found no clone site at all — it has stopped working")
    must(not unguarded,
         "these clone a base image and never ask whether it is fit: "
         f"{unguarded}. Add `tools/base-image fit \"$BASE\" --purpose …` "
         "before the clone. Each of the four base-image failures happened "
         "one layer away from the previous fix; this is the enumeration "
         "that stops the fifth.")


