    must("no bake receipt covers" in out.stderr, out.stderr)
    must("good enough to COMMIT on a branch" in out.stderr, out.stderr)
    must("sequenced behind the census work" in out.stderr,
         "the deferral's own reason must be quoted back:\n" + out.stderr)
    must(r.gate("merge-check", env={"TBT_DEFER_EXT_BAKE": "1"}).returncode == 0,
