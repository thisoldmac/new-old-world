    r.receipts(doc["receipts"])

    on_lane = r.git("checkout", "-qb", "claude/018-arm-census")
    must(on_lane.returncode == 0, on_lane.stderr)
    must(r.gate("merge-check").returncode == 0,
         "a lane-to-lane merge must NOT be gated on a bake")

    r.git("checkout", "-q", "main")
    out = r.gate("merge-check")
