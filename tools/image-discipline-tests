# --------------------------------------------------------------------------
# THE GAP THE GATE HAD, and it lasted nineteen days. tools/ext-bake-gate
# requires `volumeClean` in a receipt — and a receipt describes the BAKED
# oracle. scripts/spin-up-ppc's BASE defaults to os91-runner.qcow2, which
# is never baked and so had no receipt to require anything of. It was
# dirty from 19 July to 7 August; every spin-up clone in that window
# booted into a Disk First Aid modal, and the only reason anyone found out
# is that a person saw the dialog and asked.
#
# The gate and the script named DIFFERENT FILES. So the check moved to
# where the file is, not where the receipt is.
# --------------------------------------------------------------------------

@case("provenance measures a DIRTY volume in a base no receipt covers")
def _(tmp):
    r = Repo(tmp, "vc")
    stage = os.path.join(tmp, "stage.qcow2")
    runner = os.path.join(tmp, "os91-runner.qcow2")
    fake_image(stage, b"THE ORACLE")
    hfs_image(runner, clean=False)
    r.receipts([receipt(r.digest(), stage, sha_of(stage))])
    out = sh(sys.executable, os.path.join(r.path, "tools/image-provenance"),
             runner, "--repo", r.path, env={"NOW_STAGE_IMAGE": stage})
    # It is still a plain base and still needs no receipt — the point is
    # that "no receipt expected" must not read as "nothing to say".
    must("PLAIN BASE" in out.stdout, out.stdout)
    must("VOLUME       DIRTY" in out.stdout,
         f"a dirty unbaked base must SAY so:\n{out.stdout}")
    must("Disk First Aid" in out.stdout, out.stdout)
    must("shutdown-guest.py" in out.stdout,
         f"the warning must name the cure:\n{out.stdout}")
    # A WARNING, NOT A REFUSAL — following tools/ext-bake-gate's own
    # reasoning about the oracle: whether a shared file is clean is not
    # in this run's power to fix, and stranding a contributor over a
    # slower boot is a worse failure than the boot.
    must(out.returncode == 0,
         f"a dirty base must not stop the run (exit {out.returncode})")


@case("provenance calls a clean volume clean, and an unreadable one neither")
def _(tmp):
    r = Repo(tmp, "vc2")
    stage = os.path.join(tmp, "stage.qcow2")
    good = os.path.join(tmp, "good.qcow2")
    fake_image(stage, b"THE ORACLE")
    hfs_image(good, clean=True)
    r.receipts([receipt(r.digest(), stage, sha_of(stage))])
    ok = sh(sys.executable, os.path.join(r.path, "tools/image-provenance"),
            good, "--repo", r.path, env={"NOW_STAGE_IMAGE": stage})
    must("VOLUME       clean" in ok.stdout, ok.stdout)
    must("DIRTY" not in ok.stdout, f"clean must not read as dirty:\n{ok.stdout}")

    # And the third state stays its own. An image whose volume cannot be
    # read is NOT clean — folding the two together is how a check adjacent
    # to the question comes to read like an answer to it, which is the
    # mistake volclean.py was written to end.
    mystery = os.path.join(tmp, "mystery.qcow2")
    fake_image(mystery, b"NOT A DISK AT ALL")
    huh = sh(sys.executable, os.path.join(r.path, "tools/image-provenance"),
             mystery, "--repo", r.path, env={"NOW_STAGE_IMAGE": stage})
    must("could not be asked" in huh.stdout, huh.stdout)
    must("not the same as clean" in huh.stdout, huh.stdout)


