def base_image(repo: "Repo", *args, env=None):
    return sh(sys.executable, os.path.join(repo.path, "tools/base-image"),
              *args, "--repo", repo.path, cwd=repo.path, env=env)


@case("base: a run that stages no resident is REFUSED a base with none in it")
def _(tmp):
    r = Repo(tmp, "bi1")
    img = os.path.join(tmp, "stage.qcow2")
    hfs_image(img, clean=True)
    env = {"NOW_STAGE_IMAGE": img}          # so the image IS the designated one

    # THE MUTATION, and it is the failure that costs the most: a base with
    # no current resident, and a run that will measure the plane rather
    # than stage one. The answer would come back confident and be about
    # nothing this checkout built.
    bad = base_image(r, "fit", img, "--purpose", "oracle", env=env)
    must(bad.returncode == 3, f"must refuse:\n{bad.stdout}{bad.stderr}")
    must("REFUSED" in bad.stderr, bad.stderr)

    # The NEGATIVE case, which matters as much: the same base, a run that
    # DOES stage this checkout's resident into the clone. That is what
    # scripts/spin-up-ppc does, and refusing it would be false.
    ok = base_image(r, "fit", img, "--purpose", "ppc-work",
                    "--stages-resident", env=env)
    must(ok.returncode == 0, f"staging runs must pass:\n{ok.stdout}{ok.stderr}")


