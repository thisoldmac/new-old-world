import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent


def run_gate(test_root: Path, site_dir: Path | None = None) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env["NOW_DOCS_GATE_ROOT"] = str(test_root)
    manifest = test_root / ".tracked-markdown"
    if manifest.exists():
        env["NOW_DOCS_GATE_TRACKED_MARKDOWN_MANIFEST"] = str(manifest)
    command = [sys.executable, str(ROOT / "tools/docs-gate")]
    if site_dir:
        command.extend(["--site-dir", str(site_dir)])
    return subprocess.run(
        command,
        cwd=test_root,
        env=env,
        text=True,
        capture_output=True,
    )


def run_feature_gate(test_root: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        (sys.executable, str(ROOT / "tools/product-features"), "check",
         "--root", str(test_root)),
        cwd=test_root,
        text=True,
        capture_output=True,
    )


def replace(path: Path, old: str, new: str) -> str:
    original = path.read_text()
    if old not in original:
        raise RuntimeError(f"selftest fixture moved: {old!r} not found in {path}")
    path.write_text(original.replace(old, new, 1))
    return original


def set_yaml_scalar(text: str, key: str, value: str) -> str:
    prefix = f"{key}:"
    lines = text.splitlines(keepends=True)
    matches = [index for index, line in enumerate(lines) if line.startswith(prefix)]
    if len(matches) != 1:
        raise RuntimeError(
            f"selftest fixture moved: expected one top-level {key!r}, found {len(matches)}"
        )
    index = matches[0]
    newline = "\n" if lines[index].endswith("\n") else ""
    lines[index] = f"{key}: {value}{newline}"
    return "".join(lines)


def expect_mutation(test_root: Path, name: str, path: Path, old: str, new: str, needle: str,
                    site_dir: Path | None = None) -> None:
    original = replace(path, old, new)
    try:
        result = run_gate(test_root, site_dir)
        output = result.stdout + result.stderr
        if result.returncode == 0 or needle not in output:
            raise RuntimeError(
                f"{name}: expected refusal containing {needle!r}; exit={result.returncode}\n{output}"
            )
        print(f"[docs-gate-selftest] {name}: refused by name")
    finally:
        path.write_text(original)


