#!/usr/bin/env python3
"""Render candidate 'marked unknown' styles over a REAL captured scene.

Reads a sweep-A host render PNG, finds the regions the current renderer
filled with the loud diagonal hatch (by its own signature: 0xEEEEEE ground
with 0xCCCCCC diagonals on a 6px pitch), and repaints each of them in a
candidate style. Output is one side-by-side sheet per scene.

This is a MOCK. It repaints pixels in a captured render; it proves what a
style LOOKS like, not that any renderer draws it.
"""
import sys, os
from PIL import Image, ImageDraw

G1 = (0xEE, 0xEE, 0xEE)
G2 = (0xD6, 0xD6, 0xD6)   # antialiased core of the 1px diagonal stroke
G2B = (0xE2, 0xE2, 0xE2)  # its flanks
G3 = (0xA6, 0xA6, 0xA6)
G4 = (0x88, 0x88, 0x88)


def hatch_regions(im):
    """Bounding boxes of the current hatch fill.

    Signature: a G2 pixel whose neighbour 6px to the right on the row above
    is also G2 (the diagonal steps up-right one pixel per pixel, so the
    stripe pitch of 6 shows as a G2 six columns over and six rows up).
    """
    px = im.load()
    w, h = im.size
    seed = []
    for y in range(6, h):
        for x in range(0, w - 6):
            if px[x, y][:3] != G2:
                continue
            if y + 1 >= h or x < 1:
                continue
            # A DIAGONAL, not a pinstripe: the stroke steps down-left one
            # pixel per row. Requiring that kills the Platinum title bar's
            # horizontal pinstripes, which share the same two greys.
            if px[x - 1, y + 1][:3] not in (G2, G2B):
                continue
            if px[x + 6, y][:3] == G2 and px[x + 3, y][:3] == G1:
                seed.append((x, y))
                seed.append((x + 3, y))
    if not seed:
        return []
    # Group seeds into rectangles by simple grid-flood over a coarse mask.
    cell = 4
    cw, ch = (w + cell - 1) // cell, (h + cell - 1) // cell
    mask = [[False] * cw for _ in range(ch)]
    for x, y in seed:
        mask[y // cell][x // cell] = True
    seen = [[False] * cw for _ in range(ch)]
    boxes = []
    for cy in range(ch):
        for cx in range(cw):
            if not mask[cy][cx] or seen[cy][cx]:
                continue
            stack = [(cx, cy)]
            seen[cy][cx] = True
            x0 = x1 = cx
            y0 = y1 = cy
            while stack:
                ax, ay = stack.pop()
                x0, x1 = min(x0, ax), max(x1, ax)
                y0, y1 = min(y0, ay), max(y1, ay)
                for dx in (-1, 0, 1):
                    for dy in (-1, 0, 1):
                        nx, ny = ax + dx, ay + dy
                        if 0 <= nx < cw and 0 <= ny < ch \
                           and mask[ny][nx] and not seen[ny][nx]:
                            seen[ny][nx] = True
                            stack.append((nx, ny))
            box = (x0 * cell, y0 * cell, (x1 + 1) * cell, (y1 + 1) * cell)
            if (box[2] - box[0]) < 8 or (box[3] - box[1]) < 8:
                continue
            # DENSITY, not just extent. A partly-occluded hatch (SimpleText
            # behind the Workshop window) yields a huge bbox whose interior
            # is mostly some other window; repainting that bbox would
            # clobber real content. Solid hatch runs ~0.15 seeds/px at a
            # 6px pitch, so 0.09 separates "this box IS hatch" from
            # "this box CONTAINS some hatch".
            inside = sum(1 for sx, sy in seed
                         if box[0] <= sx < box[2] and box[1] <= sy < box[3])
            area = (box[2] - box[0]) * (box[3] - box[1])
            if inside / area < 0.09:
                continue
            boxes.append(box)
    return boxes


def snap(im, box):
    """Tighten a coarse box onto the actual hatch fill extent.

    The fill is exactly G1/G2/G3/G4 pixels; walk each edge inward while the
    edge line is not predominantly those, outward while it is.
    """
    px = im.load()
    w, h = im.size
    fill = {G1, G2, G2B, G3, G4}

    def rowfrac(y, x0, x1):
        n = max(1, x1 - x0)
        return sum(1 for x in range(x0, x1) if px[x, y][:3] in fill) / n

    def colfrac(x, y0, y1):
        n = max(1, y1 - y0)
        return sum(1 for y in range(y0, y1) if px[x, y][:3] in fill) / n

    x0, y0, x1, y1 = box
    for _ in range(24):
        if y0 > 0 and rowfrac(y0 - 1, x0, x1) > 0.95:
            y0 -= 1
        else:
            break
    for _ in range(24):
        if y1 < h and rowfrac(y1, x0, x1) > 0.95:
            y1 += 1
        else:
            break
    for _ in range(24):
        if x0 > 0 and colfrac(x0 - 1, y0, y1) > 0.95:
            x0 -= 1
        else:
            break
    for _ in range(24):
        if x1 < w and colfrac(x1, y0, y1) > 0.95:
            x1 += 1
        else:
            break
    return (x0, y0, x1, y1)


# ---------------------------------------------------------------- styles

def style_flat(d, box):
    """B — flat, no texture, hairline edge. The 'is it just empty?' control."""
    d.rectangle([box[0], box[1], box[2] - 1, box[3] - 1], fill=(0xF0, 0xF0, 0xF0))
    d.rectangle([box[0], box[1], box[2] - 1, box[3] - 1], outline=(0xE0, 0xE0, 0xE0))


def style_stipple(d, box, im):
    """C — flat ground + 25% ordered stipple, hairline edge. The chosen one."""
    x0, y0, x1, y1 = box
    d.rectangle([x0, y0, x1 - 1, y1 - 1], fill=(0xEF, 0xEF, 0xEF))
    px = im.load()
    for y in range(y0, y1):
        for x in range(x0, x1):
            if (x & 1) == 0 and (y & 1) == 0:
                px[x, y] = (0xDF, 0xDF, 0xDF)
    d.rectangle([x0, y0, x1 - 1, y1 - 1], outline=(0xD2, 0xD2, 0xD2))


def style_ticks(d, box):
    """D — flat + corner crop ticks. Marker at the edges, nothing in the middle."""
    x0, y0, x1, y1 = box
    d.rectangle([x0, y0, x1 - 1, y1 - 1], fill=(0xF0, 0xF0, 0xF0))
    d.rectangle([x0, y0, x1 - 1, y1 - 1], outline=(0xDD, 0xDD, 0xDD))
    n = min(6, (x1 - x0) // 3, (y1 - y0) // 3)
    c = (0xA6, 0xA6, 0xA6)
    for (cx, cy, sx, sy) in ((x0, y0, 1, 1), (x1 - 1, y0, -1, 1),
                             (x0, y1 - 1, 1, -1), (x1 - 1, y1 - 1, -1, -1)):
        d.line([cx, cy, cx + sx * n, cy], fill=c)
        d.line([cx, cy, cx, cy + sy * n], fill=c)


def apply(src, boxes, fn):
    im = src.copy().convert("RGB")
    d = ImageDraw.Draw(im)
    for b in boxes:
        if fn is style_stipple:
            fn(d, b, im)
        else:
            fn(d, b)
    return im


def label_strip(width, text):
    from PIL import ImageFont
    im = Image.new("RGB", (width, 18), (0x22, 0x22, 0x22))
    d = ImageDraw.Draw(im)
    d.text((6, 4), text, fill=(0xFF, 0xFF, 0xFF))
    return im


def sheet(panels, crop=None):
    imgs = []
    for title, im in panels:
        if crop:
            im = im.crop(crop)
        strip = label_strip(im.width, title)
        cell = Image.new("RGB", (im.width, im.height + 18), (0x22, 0x22, 0x22))
        cell.paste(strip, (0, 0))
        cell.paste(im, (0, 18))
        imgs.append(cell)
    gap = 8
    W = sum(i.width for i in imgs) + gap * (len(imgs) + 1)
    H = max(i.height for i in imgs) + gap * 2
    out = Image.new("RGB", (W, H), (0x22, 0x22, 0x22))
    x = gap
    for i in imgs:
        out.paste(i, (x, gap))
        x += i.width + gap
    return out


if __name__ == "__main__":
    src_path, out_path = sys.argv[1], sys.argv[2]
    crop = None
    if len(sys.argv) > 3:
        crop = tuple(int(v) for v in sys.argv[3].split(","))
    src = Image.open(src_path).convert("RGB")
    raw = hatch_regions(src)
    boxes = raw
    print(f"{os.path.basename(src_path)}: {len(boxes)} hatch regions", boxes)
    panels = [
        ("A  current hatch (baseline)", src),
        ("B  flat + hairline", apply(src, boxes, style_flat)),
        ("C  quiet stipple  <- proposed", apply(src, boxes, style_stipple)),
        ("D  flat + corner ticks", apply(src, boxes, style_ticks)),
    ]
    sheet(panels, crop).save(out_path)
    print("wrote", out_path)
