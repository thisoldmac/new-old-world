#!/usr/bin/env python3
"""Write RFC 9116 and crawler assets only for a configured release."""

from __future__ import annotations

import argparse
from datetime import datetime
import os
from pathlib import Path
import sys

import yaml


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--site-dir", required=True)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    root = Path(os.environ.get("NOW_DOCS_GATE_ROOT", Path(__file__).resolve().parent.parent)).resolve()
    config = yaml.safe_load((root / "docs/site-integration.yaml").read_text())
    missing = [key for key in config["release_requirements"] if not config.get(key)]
    if missing:
        print("release integration is incomplete: " + ", ".join(missing), file=sys.stderr)
        return 1
    try:
        expires = datetime.fromisoformat(str(config["security_expires"]).replace("Z", "+00:00"))
    except ValueError:
        print("security_expires must be an ISO 8601 timestamp", file=sys.stderr)
        return 1
    if expires.tzinfo is None:
        print("security_expires must include a timezone", file=sys.stderr)
        return 1
    if expires <= datetime.now(expires.tzinfo):
        print("security_expires must be in the future", file=sys.stderr)
        return 1

    origin = str(config["canonical_origin"]).rstrip("/")
    base_path = "/" + str(config["base_path"]).strip("/")
    if base_path != "/":
        base_path += "/"
    site_origin = origin + base_path
    site = Path(args.site_dir)
    well_known = site / ".well-known"
    security = (
        f"Contact: {config['security_contact']}\n"
        f"Expires: {config['security_expires']}\n"
        f"Canonical: {origin}/.well-known/security.txt\n"
        f"Policy: {site_origin}developer-guide/reference/security/\n"
    )
    robots = (
        "User-agent: *\nAllow: /\n" f"Sitemap: {site_origin}sitemap.xml\n"
    )
    if args.check:
        expected = {well_known / "security.txt": security, site / "robots.txt": robots}
        stale = [path for path, content in expected.items() if not path.exists() or path.read_text() != content]
        if stale:
            for path in stale:
                print(f"release asset is stale: {path}", file=sys.stderr)
            return 1
        print("Release assets match the integration source")
        return 0
    well_known.mkdir(parents=True, exist_ok=True)
    (well_known / "security.txt").write_text(security)
    (site / "robots.txt").write_text(robots)
    print("Release assets: RFC 9116 security.txt and robots.txt")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
