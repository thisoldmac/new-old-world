#!/bin/sh
# Local main is a read-only mirror of the branch GitHub accepted. Feature
# branches never land through this checkout; they land through protected PRs.
set -eu

root=$(git rev-parse --show-toplevel)
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "$branch" != main ]; then
    echo "[sync-main] run from the public clone's checked-out main branch" >&2
    exit 1
fi
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "[sync-main] local main has tracked changes" >&2
    exit 1
fi

"$root/tools/main-ref-policy" config-check
git fetch --prune origin main
old=$(git rev-parse --verify refs/heads/main)
new=$(git rev-parse --verify refs/remotes/origin/main)
"$root/tools/main-ref-policy" main-ref-check "$old" "$new"
git merge --ff-only refs/remotes/origin/main
echo "[sync-main] local main matches origin/main at $new"
