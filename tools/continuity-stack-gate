#!/usr/bin/env python3
"""Refuse a Continuity handoff whose three compatibility faces disagree.

An application, extension, and host can each be valid on their own and still
form an unusable stack.  This gate reads the shared source contract and the
two immutable update sidecars, then writes one manifest for the assembled
handoff.  It is packaging evidence, not proof that a Macintosh loaded the
extension; a cold-boot observation remains the final layer.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import plistlib
import re
import subprocess
import sys
from pathlib import Path


class Refusal(Exception):
    pass


def numeric_macro(path: Path, name: str) -> int:
    match = re.search(
        rf"^\s*#define\s+{re.escape(name)}\s+"
        r"(0[xX][0-9a-fA-F]+|[0-9]+)[uUlL]*\s*"
        r"(?:/\*.*\*/)?\s*$",
        path.read_text(), re.MULTILINE)
    if not match:
        raise Refusal(f"{path}: no numeric {name} definition")
    return int(match.group(1), 0)


def swift_int(path: Path, name: str) -> int:
    match = re.search(
        rf"^\s*static let {re.escape(name)}(?:\s*:\s*\w+)?\s*=\s*([0-9]+)\s*$",
        path.read_text(), re.MULTILINE)
    if not match:
        raise Refusal(f"{path}: no integer Swift constant {name}")
    return int(match.group(1))


def swift_string(path: Path, name: str) -> str:
    match = re.search(
        rf'^\s*static let {re.escape(name)}\s*=\s*"([^"]+)"\s*$',
        path.read_text(), re.MULTILINE)
    if not match:
        raise Refusal(f"{path}: no String Swift constant {name}")
    return match.group(1)


def swift_block(path: Path, start: str, end: str | None) -> str:
    text = path.read_text()
    begin = text.find(start)
    if begin < 0:
        raise Refusal(f"{path}: no Swift declaration {start!r}")
    finish = text.find(end, begin + len(start)) if end else len(text)
    if finish < 0:
        raise Refusal(f"{path}: no Swift declaration {end!r}")
    return text[begin:finish]


def swift_block_number(text: str, name: str) -> int:
    match = re.search(
        rf"^\s*static let {re.escape(name)}(?:\s*:\s*\w+)?\s*=\s*"
        r"(0x[0-9a-fA-F_]+|[0-9]+)\s*(?://.*)?$",
        text, re.MULTILINE)
    if not match:
        raise Refusal(f"Swift Continuity declaration has no numeric {name}")
    return int(match.group(1).replace("_", ""), 0)


def swift_flag(text: str, name: str) -> int:
    match = re.search(
        rf"^\s*static let {re.escape(name)}\s*=\s*Flags\(rawValue:\s*"
        r"1\s*<<\s*([0-9]+)\)\s*$", text, re.MULTILINE)
    if not match:
        raise Refusal(f"Swift Continuity flags have no derived {name}")
    return 1 << int(match.group(1))


def swift_case(text: str, name: str) -> int:
    match = re.search(
        rf"^\s*case\s+{re.escape(name)}\s*=\s*([0-9]+)\s*$",
        text, re.MULTILINE)
    if not match:
        raise Refusal(f"Swift Continuity enum has no numeric case {name}")
    return int(match.group(1))


def continuity_instruments(root: Path) -> list[Path]:
    """Discover speakers by behavior, so a new tool cannot evade a list."""
    found: list[Path] = []
    for relative in ("tools", "scripts/probes"):
        directory = root / relative
        if not directory.exists():
            continue
        for path in directory.rglob("*.py"):
            if path == root / "tools/continuity_contract.py":
                continue
            text = path.read_text(errors="replace")
            if (re.search(
                    r'["\']type["\']\s*:\s*["\']continuity\.arm["\']',
                    text)
                    or "0x4E574331" in text or "0x4E574131" in text
                    or "IHHIIIIhhIHHIIHH" in text
                    or "IHHIIIIIHHIII" in text):
                found.append(path)
    return sorted(found)


def check_continuity_instruments(root: Path) -> None:
    offenders: list[str] = []
    patterns = (
        (r'["\']version["\']\s*:\s*[0-9]+', "inline control version"),
        (r"0x4E574331|0x4E574131", "inline datagram magic"),
        (r"struct\.Struct\([\"\']>IHHIIIIhhIHHIIHH[\"\']\)",
         "local state layout"),
        (r"struct\.Struct\([\"\']>IHHIIIIIHHIII[\"\']\)",
         "local acknowledgement layout"),
        (r'\["exitReason"\]\s*!=\s*0\b', "inline exit state"),
        (r'\["state"\]\s*==\s*2\b', "inline active state"),
    )
    for path in continuity_instruments(root):
        text = path.read_text(errors="replace")
        relative = path.relative_to(root)
        if "continuity_contract" not in text:
            offenders.append(f"{relative}: does not import continuity_contract")
        for pattern, reason in patterns:
            if re.search(pattern, text):
                offenders.append(f"{relative}: {reason}")
    if offenders:
        raise Refusal("Continuity speakers copy shared constants:\n  "
                      + "\n  ".join(offenders))


def source_contract(root: Path) -> dict[str, object]:
    wire = numeric_macro(root / "contract/continuity_udp.h",
                         "NOW_CONTINUITY_VERSION")
    table = numeric_macro(root / "contract/peek_table.h",
                          "NOW_CONTINUITY_FORMAT_CURRENT")
    resident_major = numeric_macro(root / "contract/resident_version.h",
                                   "NOW_RESIDENT_VERSION_MAJOR")
    resident_minor = numeric_macro(root / "contract/resident_version.h",
                                   "NOW_RESIDENT_VERSION_MINOR")
    resident = f"{resident_major}.{resident_minor}"

    datagram_path = root / "now-host/Sources/Host/ContinuityDatagram.swift"
    host_datagram = swift_int(datagram_path, "version")
    state_block = swift_block(
        datagram_path, "struct ContinuityStateDatagram", "struct ContinuityAckDatagram")
    ack_block = swift_block(
        datagram_path, "struct ContinuityAckDatagram", "enum ContinuityDatagramError")
    host_pairs = (
        (swift_block_number(state_block, "byteCount"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_STATE_BYTES"), "state byte count"),
        (swift_block_number(state_block, "magic"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_STATE_MAGIC"), "state magic"),
        (swift_flag(state_block, "inside"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_FLAG_INSIDE"), "inside flag"),
        (swift_flag(state_block, "primaryDown"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_FLAG_PRIMARY_DOWN"), "primary-down flag"),
        (swift_flag(state_block, "keepalive"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_FLAG_KEEPALIVE"), "keepalive flag"),
        (swift_block_number(ack_block, "byteCount"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_ACK_BYTES"), "ack byte count"),
        (swift_block_number(ack_block, "magic"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_ACK_MAGIC"), "ack magic"),
        (swift_case(ack_block, "inactive"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_ACK_INACTIVE"), "inactive state"),
        (swift_case(ack_block, "armed"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_ACK_ARMED"), "armed state"),
        (swift_case(ack_block, "active"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_ACK_ACTIVE"), "active state"),
        (swift_case(ack_block, "none"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_EXIT_NONE"), "no-exit state"),
        (swift_case(ack_block, "hostLeft"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_EXIT_HOST_LEFT"), "host-left state"),
        (swift_case(ack_block, "guestInput"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_EXIT_GUEST_INPUT"), "guest-input state"),
        (swift_case(ack_block, "leaseExpired"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_EXIT_LEASE_EXPIRED"), "lease-expired state"),
        (swift_case(ack_block, "disarmed"),
         numeric_macro(root / "contract/continuity_udp.h",
                       "NOW_CONTINUITY_EXIT_DISARMED"), "disarmed state"),
    )
    for host_value, shared_value, label in host_pairs:
        if host_value != shared_value:
            raise Refusal(
                f"host Continuity {label} {host_value} != shared {shared_value}")
    host_contract = root / "now-host/Sources/Host/ContractMessages.swift"
    host_table = swift_int(host_contract, "residentTableVersion")
    host_resident = swift_string(host_contract, "residentVersion")
    if host_datagram != wire:
        raise Refusal(
            f"host Continuity wire {host_datagram} != shared wire {wire}")
    if host_table != table:
        raise Refusal(
            f"host resident table {host_table} != shared table {table}")
    if host_resident != resident:
        raise Refusal(
            f"host resident release {host_resident} != shared {resident}")

    for relative in (
        "now-guest-ppc/src/input/continuity_intake.c",
        "ext/src/now_ext_continuity.c",
    ):
        if "NOW_CONTINUITY_FORMAT_CURRENT" not in (root / relative).read_text():
            raise Refusal(
                f"{relative}: bypasses the shared current Continuity format")
    check_continuity_instruments(root)
    return {
        "continuityWire": wire,
        "continuityTable": table,
        "resident": resident,
    }


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_artifact(path: Path, component: str,
                  expected: dict[str, object]) -> dict[str, object]:
    sidecar = path.with_name(path.name + ".now-update.json")
    try:
        manifest = json.loads(sidecar.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise Refusal(f"{sidecar}: unreadable update manifest: {error}")
    if manifest.get("component") != component:
        raise Refusal(
            f"{sidecar}: component {manifest.get('component')!r}, expected {component}")
    if manifest.get("compatibility") != expected:
        raise Refusal(
            f"{sidecar}: compatibility {manifest.get('compatibility')!r}, "
            f"expected {expected!r}")
    if manifest.get("bytes") != path.stat().st_size:
        raise Refusal(f"{path}: byte count does not match its manifest")
    actual = digest(path)
    if manifest.get("sha256") != actual:
        raise Refusal(f"{path}: SHA-256 does not match its manifest")
    build = manifest.get("build")
    if not isinstance(build, str) or not re.fullmatch(r"[0-9a-f]{64}", build):
        raise Refusal(f"{sidecar}: invalid full build identity")
    if component == "extension" and manifest.get("version") != expected["resident"]:
        raise Refusal(
            f"{sidecar}: release {manifest.get('version')!r}, expected resident "
            f"{expected['resident']}")
    return manifest


def host_identity(app: Path, application_version: str) -> dict[str, object]:
    plist_path = app / "Contents/Info.plist"
    try:
        with plist_path.open("rb") as stream:
            plist = plistlib.load(stream)
    except (OSError, plistlib.InvalidFileException) as error:
        raise Refusal(f"{plist_path}: unreadable host identity: {error}")
    bundle_id = plist.get("CFBundleIdentifier")
    version = plist.get("CFBundleShortVersionString")
    if bundle_id != "dev.newoldworld.now.continuity":
        raise Refusal(f"{app}: bundle id {bundle_id!r} is not the Continuity profile")
    if version != application_version:
        raise Refusal(
            f"{app}: host version {version!r} != guest version {application_version!r}")
    result = subprocess.run(
        ("codesign", "-d", "--verbose=4", str(app)), text=True,
        capture_output=True)
    signing = result.stdout + result.stderr
    if result.returncode:
        raise Refusal(f"{app}: codesign could not read the host signature")
    team = re.search(r"^TeamIdentifier=(.+)$", signing, re.MULTILINE)
    cdhash = re.search(r"^CDHash=(.+)$", signing, re.MULTILINE)
    if team is None or team.group(1) != "B93A9CG7F9":
        raise Refusal(f"{app}: wrong or missing signing team")
    if cdhash is None:
        raise Refusal(f"{app}: missing code-directory hash")
    return {
        "bundleIdentifier": bundle_id,
        "version": version,
        "teamIdentifier": team.group(1),
        "codeDirectoryHash": cdhash.group(1),
    }


def revision(root: Path) -> tuple[str, bool]:
    head = subprocess.run(
        ("git", "-C", str(root), "rev-parse", "HEAD"), text=True,
        capture_output=True)
    status = subprocess.run(
        ("git", "-C", str(root), "status", "--porcelain",
         "--untracked-files=no"), text=True, capture_output=True)
    if head.returncode or status.returncode:
        raise Refusal("could not read source revision")
    return head.stdout.strip(), bool(status.stdout.strip())


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path,
                        default=Path(__file__).resolve().parent.parent)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("source")
    verify = sub.add_parser("verify")
    verify.add_argument("--application", required=True, type=Path)
    verify.add_argument("--extension", required=True, type=Path)
    verify.add_argument("--host-app", type=Path)
    verify.add_argument("--output", type=Path)
    args = parser.parse_args()

    root = args.root.resolve()
    compatibility = source_contract(root)
    if args.command == "source":
        print(json.dumps(compatibility, sort_keys=True))
        return 0

    application = load_artifact(args.application.resolve(), "application",
                                compatibility)
    extension = load_artifact(args.extension.resolve(), "extension",
                              compatibility)
    if application["compatibility"] != extension["compatibility"]:
        raise Refusal("application and extension compatibility differ")
    head, dirty = revision(root)
    document: dict[str, object] = {
        "schema": 1,
        "sourceRevision": head,
        "sourceDirty": dirty,
        "compatibility": compatibility,
        "application": application,
        "extension": extension,
    }
    if args.host_app:
        document["host"] = host_identity(
            args.host_app.resolve(), str(application["version"]))
    rendered = json.dumps(document, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.write_text(rendered)
    else:
        print(rendered, end="")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (Refusal, OSError) as error:
        print(f"continuity-stack-gate: REFUSED: {error}", file=sys.stderr)
        raise SystemExit(1)
