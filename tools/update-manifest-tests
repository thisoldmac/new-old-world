#!/usr/bin/env python3
"""Mutation tests for development identity and immutable release tags."""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
BUILD = "b" * 64


def run(*args: str, cwd: Path, check: bool = False):
    result = subprocess.run(args, cwd=cwd, text=True, capture_output=True)
    if check and result.returncode:
        raise AssertionError(result.stdout + result.stderr)
    return result


def invoke(repo: Path, channel: str = "development"):
    return run(str(repo / "tools/write-update-manifest.py"),
               "--artifact", "New Old World.bin", "--component", "application",
               "--version-header", "contract/product_version.h",
               "--version-major", "NOW_PRODUCT_VERSION_MAJOR",
               "--version-minor", "NOW_PRODUCT_VERSION_MINOR",
               "--version-patch", "NOW_PRODUCT_VERSION_PATCH",
               "--identity-header", "identity.h", "--identity-define",
               "NOW_BUILD_ID", "--channel", channel, "--repo-root", str(repo),
               cwd=repo)


def main() -> int:
    with tempfile.TemporaryDirectory(prefix="now-update-manifest-") as tmp:
        repo = Path(tmp)
        (repo / "tools").mkdir()
        (repo / "contract").mkdir()
        shutil.copy(ROOT / "tools/write-update-manifest.py",
                    repo / "tools/write-update-manifest.py")
        os.chmod(repo / "tools/write-update-manifest.py", 0o755)
        (repo / "contract/product_version.h").write_text(
            "#define NOW_PRODUCT_VERSION_MAJOR 1\n"
            "#define NOW_PRODUCT_VERSION_MINOR 2\n"
            "#define NOW_PRODUCT_VERSION_PATCH 3\n")
        (repo / "identity.h").write_text(f'#define NOW_BUILD_ID "{BUILD}"\n')
        artifact = repo / "New Old World.bin"
        artifact.write_bytes(b"release bytes")
        digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
        run("git", "init", "-q", "-b", "main", cwd=repo, check=True)
        run("git", "config", "user.email", "release@example.invalid",
            cwd=repo, check=True)
        run("git", "config", "user.name", "Release Gate", cwd=repo,
            check=True)
        run("git", "add", "tools", "contract", "identity.h", cwd=repo,
            check=True)
        run("git", "commit", "-qm", "release source", cwd=repo, check=True)

        development = invoke(repo)
        if development.returncode:
            raise AssertionError(development.stdout + development.stderr)
        manifest = json.loads(
            (repo / "New Old World.bin.now-update.json").read_text())
        if (manifest["build"] != BUILD or manifest["sha256"] != digest
                or manifest["sourceRevision"]
                != run("git", "rev-parse", "HEAD", cwd=repo,
                       check=True).stdout.strip()):
            raise AssertionError("development sidecar lost exact identities")

        no_tag = invoke(repo, "release")
        if no_tag.returncode == 0 or "annotated tag" not in no_tag.stderr:
            raise AssertionError("an untagged release publication passed")
        annotation = ("NOW release 1.2.3\n\nNOW-Component: application\n"
                      f"NOW-Build: {BUILD}\nNOW-SHA256: {digest}\n")
        run("git", "tag", "-a", "now-product-v1.2.3", "-m", annotation,
            cwd=repo, check=True)
        release = invoke(repo, "release")
        if release.returncode:
            raise AssertionError(release.stdout + release.stderr)

        artifact.write_bytes(b"different release bytes")
        collision = invoke(repo, "release")
        if collision.returncode == 0 or "does not pin this artifact" not in collision.stderr:
            raise AssertionError("same release tag accepted different bytes")

    print("update manifest: 4 release identity mutations passed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AssertionError as exc:
        print(f"FAILED: {exc}")
        raise SystemExit(1)
