def rules_block():
    path = os.path.join(ROOT, LOOP_DOC)
    try:
        with open(path) as f:
            text = f.read()
        body = text.split("## 1. The rules, recited every pass", 1)[1]
        body = body.split("\n---", 1)[0].strip()
    except (IOError, IndexError):
        return ("mirror-gate: %s could not be read. That is itself a "
                "problem worth stopping for." % LOOP_DOC)
    return ("--- the rules, from %s, read from the file just now ---\n%s\n"
            "\nThe ladder and the phases are in the same file. "
            "Findings: %s" % (LOOP_DOC, body, NOTES))


# --------------------------------------------------------------------------
# State
# --------------------------------------------------------------------------

def now_iso():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def load():
    if not os.path.exists(STATE):
        return None
    with open(STATE) as f:
        return json.load(f)


def save(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
        f.write("\n")
    os.replace(tmp, STATE)


def rows_for(rungs, app):
    out = [{"id": rid, "rung": 0, "what": what,
            "result": None, "note": ""} for rid, what in PREFLIGHT]
    for r in rungs:
        title, items = RUNGS[r]
        for rid, what in items:
            what = what if r != 5 or not app else "%s: %s" % (app, what)
            out.append({"id": rid, "rung": r, "what": what,
                        "result": None, "note": ""})
    return out


def open_cycle(state):
    """The cycle still being swept, or None."""
    if not state or not state.get("cycles"):
        return None
    last = state["cycles"][-1]
    return last if last.get("state") == "open" else None


def unpopulated(cycle):
    return [r for r in cycle["rows"] if not r["result"]]


