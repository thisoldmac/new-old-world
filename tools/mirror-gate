#!/usr/bin/env python3
"""The deterministic half of the Mirror drive loop.

`docs/mirror-drive-loop.md` is the rules. This is the part that does not
depend on anyone remembering them.

It exists because the honour-system version failed in a specific,
measurable way: five drive notes claimed `rules re-read` and only two of
those re-reads happened. The audit field designed to catch the drift was
itself fabricated. So the refresh is no longer a step anyone reports — it
is a consequence of a Stop hook that will not let the turn end, and whose
rejection text carries the rules back into context.

Three commands matter:

    tools/mirror-gate begin 13 --rungs 1,2 [--app "Sherlock 2"]
    tools/mirror-gate row r1.move pass "watched it move 60px right"
    tools/mirror-gate check          # what the Stop hook runs

and two say the work may legitimately end:

    tools/mirror-gate pause --reason "needs metal, michelle's call"
    tools/mirror-gate done --evidence "..."

Everything else (`status`, `guard-bash`) is support.

State lives in docs/local/mirror-sweep-state.json, which is gitignored:
it describes one worktree's run, not the project.
"""

import json
import os
import re
import sys
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
STATE = os.path.join(ROOT, "docs", "local", "mirror-sweep-state.json")
LOOP_DOC = "docs/mirror-drive-loop.md"
NOTES = "docs/local/mirror-drive-notes.md"

# The gate gives up after this many consecutive blocks with no progress
# in between. A hook that can never be satisfied is a wedge, and a wedge
# is worse than the drift it was meant to stop -- but it says so loudly
# rather than quietly letting the session end.
MAX_FRUITLESS_BLOCKS = 5


# --------------------------------------------------------------------------
# The ladder, as rows
#
# Generated here rather than typed into the state file by hand, so a cycle
# cannot choose its own checklist -- only fill one in. The wording tracks
# docs/mirror-drive-loop.md section 3; change it there first.
# --------------------------------------------------------------------------

