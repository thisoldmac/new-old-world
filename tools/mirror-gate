def cmd_begin(args):
    n = None
    rungs, app = "1,2", None
    it = iter(args)
    for a in it:
        if a == "--rungs":
            rungs = next(it)
        elif a == "--app":
            app = next(it)
        elif n is None:
            n = a
    if n is None:
        die("usage: mirror-gate begin <cycle-number> [--rungs 1,2,3] [--app NAME]")
    try:
        rung_list = sorted({int(x) for x in rungs.split(",") if x.strip()})
    except ValueError:
        die("--rungs takes comma-separated rung numbers, e.g. 1,2,3")
    if not rung_list or any(r not in RUNGS for r in rung_list):
        die("rungs must be drawn from %s" % sorted(RUNGS))

    state = load() or {"cycles": [], "done": None, "pause": None,
                       "fruitless_blocks": 0}
    cur = open_cycle(state)
    if cur:
        die("cycle %s is still open with %d rows unfilled. Finish the sweep "
            "(mirror-gate row ...) before beginning another."
            % (cur["n"], len(unpopulated(cur))))

    # The ladder has to move. Two cycles at the same reach is a sweep that
    # has stopped climbing, which is how rung 2 stayed unfinished while
    # rung 1 was re-polished.
    prior = [c["rungs"] for c in state["cycles"][-2:]]
    if len(prior) == 2 and all(p == rung_list for p in prior):
        die("cycles %s and %s already swept rungs %s. Widen the reach or "
            "state why in a note; the ladder is meant to climb."
            % (state["cycles"][-2]["n"], state["cycles"][-1]["n"], rung_list))

    cycle = {"n": n, "opened": now_iso(), "state": "open",
             "rungs": rung_list, "app": app,
             "rows": rows_for(rung_list, app), "findings": []}
    state["cycles"].append(cycle)
    state["pause"] = None
    state["fruitless_blocks"] = 0
    save(state)
    # THE REFRESH, as a consequence rather than a step. The Stop hook
    # only quotes the rules when a turn tries to END; nothing made them
    # land at the START of a cycle, which is where drift begins. `begin`
    # is mandatory to open one, so printing them here means every cycle
    # opens with the rules in context, read from the file.
    print(rules_block())
    print()
    print("cycle %s open -- rungs %s%s, %d rows"
          % (n, rung_list, (" app=%s" % app) if app else "", len(cycle["rows"])))
    for r in cycle["rows"]:
        print("  [ ] %-18s %s" % (r["id"], r["what"]))


def cmd_row(args):
    if len(args) < 2:
        die("usage: mirror-gate row <id> <%s> [--evidence MANIFEST] [note]"
            % "|".join(RESULTS))
    rid, result = args[0], args[1]
    rest = list(args[2:])
    evidence = None
    if "--evidence" in rest:
        i = rest.index("--evidence")
        if i + 1 >= len(rest):
            die("--evidence needs the path to a correlated manifest")
        evidence = rest[i + 1]
        del rest[i:i + 2]
    if "--shot" in rest:
        die("--shot is no longer sufficient. Use --evidence with the "
            "correlated Mirror/input/guest/state/operation/log manifest")
    note = " ".join(rest)
    if result not in RESULTS:
        die("result must be one of %s" % ", ".join(RESULTS))
    if result in ("blocked", "n/a") and not note:
        die("a %s row needs a note saying what blocked it or why it does "
            "not apply -- an unexplained skip reads as coverage" % result)
    state = load()
    cycle = open_cycle(state)
    if not cycle:
        die("no cycle is open. mirror-gate begin <n> first.")
    target = next((r for r in cycle["rows"] if r["id"] == rid), None)
    if target is None:
        die("no row %r in cycle %s. Rows: %s"
            % (rid, cycle["n"], ", ".join(x["id"] for x in cycle["rows"])))

    preflight_ids = [row_id for row_id, _ in PREFLIGHT]
    if rid in preflight_ids:
        prior = preflight_ids[:preflight_ids.index(rid)]
        unfinished = [row_id for row_id in prior
                      if next((r for r in cycle["rows"]
                               if r["id"] == row_id), {}).get("result") is None]
        if unfinished:
            die("sanity preflight is ordered; attempt first: %s"
                % ", ".join(unfinished))
    else:
        preflight = [r for r in cycle["rows"] if r["id"] in preflight_ids]
        unattempted = [r for r in preflight if r.get("result") is None]
        if unattempted:
            die("sanity preflight must be attempted before slice testing: %s. "
                "Record red rows, then keep testing independent surfaces."
                % ", ".join(r["id"] for r in unattempted))

    if result in ("pass", "fail"):
        if not evidence:
            die("a %s needs --evidence <manifest>. MCP-only success or a "
                "guest screendump by itself cannot score UX" % result)
        manifest = load_evidence(evidence, rid)
    else:
        manifest = None

    for r in cycle["rows"]:
        if r["id"] == rid:
            r["result"], r["note"] = result, note
            r["at"] = now_iso()
            r["evidence"] = evidence or ""
            r["shot"] = (manifest or {}).get("guest", {}).get("path", "")
            break
    else:
        die("no row %r in cycle %s. Rows: %s"
            % (rid, cycle["n"], ", ".join(x["id"] for x in cycle["rows"])))
    state["fruitless_blocks"] = 0
    save(state)
    left = len(unpopulated(cycle))
    print("%s = %s (%d row%s left)" % (rid, result, left,
                                       "" if left == 1 else "s"))


def parse_iso(value, label):
    if not isinstance(value, str) or not value:
        die("evidence %s must be a non-empty ISO-8601 timestamp" % label)
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        die("evidence %s is not an ISO-8601 timestamp: %r" % (label, value))
    if parsed.tzinfo is None:
        die("evidence %s must include a timezone" % label)
    return parsed


def evidence_file(manifest_path, section, field="path"):
    value = section.get(field)
    if not isinstance(value, str) or not value:
        die("evidence %s.%s must name a file" % (section["_name"], field))
    path = value if os.path.isabs(value) else os.path.join(
        os.path.dirname(manifest_path), value)
    if not os.path.isfile(path):
        die("evidence %s.%s does not exist: %r"
            % (section["_name"], field, value))
    return path


def evidence_json(path, section):
    artifact = evidence_file(path, section)
    try:
        with open(artifact) as f:
            return json.load(f)
    except (OSError, ValueError) as exc:
        die("evidence %s.path is not readable JSON: %s"
            % (section["_name"], exc))


def load_evidence(path, rid):
    if not os.path.isfile(path):
        die("no evidence manifest at %r" % path)
    try:
        with open(path) as f:
            manifest = json.load(f)
    except (OSError, ValueError) as exc:
        die("evidence manifest %r is not readable JSON: %s" % (path, exc))

    if manifest.get("schema") != EVIDENCE_SCHEMA:
        die("evidence schema must be %r" % EVIDENCE_SCHEMA)
    if manifest.get("row") != rid:
        die("evidence row %r does not match scored row %r"
            % (manifest.get("row"), rid))

    required = ("input", "mirror", "guest", "state", "operation",
                "guestLog")
    for name in required:
        if not isinstance(manifest.get(name), dict):
            die("evidence manifest is missing object %r" % name)
        manifest[name]["_name"] = name

    event = manifest["input"]
    if event.get("device") not in ("keyboard", "mouse"):
        die("evidence input.device must be keyboard or mouse; MCP actuation "
            "cannot score UX")
    if event.get("target") != "NOW Mirror":
        die("evidence input.target must be exactly 'NOW Mirror'")
    if event.get("source") != "computer-use":
        die("evidence input.source must be computer-use; API or MCP "
            "actuation cannot score UX")
    if not isinstance(event.get("event"), str) or not event["event"].strip():
        die("evidence input.event must describe the keyboard or mouse input")

    mirror = manifest["mirror"]
    guest = manifest["guest"]
    state = manifest["state"]
    operation = manifest["operation"]
    guest_log = manifest["guestLog"]
    for section in (mirror, guest):
        evidence_file(path, section)
    state_artifact = evidence_json(path, state)
    operation_artifact = evidence_json(path, operation)
    guest_log_path = evidence_file(path, guest_log)

    snapshot = mirror.get("snapshotId")
    if not isinstance(snapshot, str) or not snapshot:
        die("evidence mirror.snapshotId must be non-empty")
    if state.get("snapshotId") != snapshot:
        die("evidence state.snapshotId must match mirror.snapshotId")
    if state_artifact.get("snapshotId") != snapshot:
        die("evidence state artifact must contain mirror.snapshotId")

    operation_id = operation.get("id")
    if not isinstance(operation_id, str) or not operation_id:
        die("evidence operation.id must be non-empty")
    if operation.get("source") != "human":
        die("evidence operation.source must be human; an MCP operation "
            "cannot score UX")
    if operation_artifact.get("id") != operation_id \
            or operation_artifact.get("source") != "human":
        die("evidence operation artifact must contain the human operation.id")
    if guest_log.get("operationId") != operation_id:
        die("evidence guestLog.operationId must match operation.id")
    try:
        with open(guest_log_path) as f:
            log_text = f.read()
    except OSError as exc:
        die("evidence guestLog.path cannot be read: %s" % exc)
    if operation_id not in log_text:
        die("evidence guest log does not contain operation.id")

    mirror_at = parse_iso(mirror.get("capturedAt"), "mirror.capturedAt")
    guest_at = parse_iso(guest.get("capturedAt"), "guest.capturedAt")
    if abs((mirror_at - guest_at).total_seconds()) \
            > EVIDENCE_CAPTURE_SLOP_SECONDS:
        die("Mirror and guest captures are not the same settled moment "
            "(more than %.1fs apart)" % EVIDENCE_CAPTURE_SLOP_SECONDS)
    if guest.get("source") != "qmp-screendump":
        die("evidence guest.source must be qmp-screendump (observation only)")
    if mirror.get("source") != "now-mirror-window":
        die("evidence mirror.source must be now-mirror-window")

    for name in required:
        manifest[name].pop("_name", None)
    return manifest


def cmd_finding(args):
    if not args:
        die('usage: mirror-gate finding "D13.2 the HD window renders empty"')
    state = load()
    cycle = open_cycle(state)
    if not cycle:
        die("no cycle is open.")
    cycle["findings"].append({"at": now_iso(), "text": " ".join(args)})
    state["fruitless_blocks"] = 0
    save(state)
    print("recorded (%d finding%s this cycle)"
          % (len(cycle["findings"]), "" if len(cycle["findings"]) == 1 else "s"))


def cmd_close(args):
    state = load()
    cycle = open_cycle(state)
    if not cycle:
        die("no cycle is open.")
    missing = unpopulated(cycle)
    preflight_ids = {row_id for row_id, _ in PREFLIGHT}
    preflight_failed = any(
        r["id"] in preflight_ids and r.get("result") in ("fail", "blocked")
        for r in cycle["rows"])
    if missing and preflight_failed:
        for row in missing:
            row["result"] = "blocked"
            row["note"] = "not attempted: mandatory sanity preflight failed"
            row["at"] = now_iso()
            row["evidence"] = ""
            row["shot"] = ""
        missing = []
    if missing:
        die("%d row%s unfilled: %s" % (len(missing), "" if len(missing) == 1
                                       else "s",
                                       ", ".join(r["id"] for r in missing)))
    cycle["state"] = "swept"
    cycle["closed"] = now_iso()
    state["fruitless_blocks"] = 0
    save(state)
    fails = [r for r in cycle["rows"] if r["result"] in ("fail", "blocked")]
    print("cycle %s swept: %d/%d passed, %d to triage"
          % (cycle["n"], sum(1 for r in cycle["rows"] if r["result"] == "pass"),
             len(cycle["rows"]), len(fails)))
    print("Triage, patch the blockers plus at most two others, then "
          "`begin` the next cycle. Closing a sweep is not stopping.")


def cmd_pause(args):
    reason = ""
    if "--reason" in args:
        reason = " ".join(args[args.index("--reason") + 1:])
    if not reason:
        die('usage: mirror-gate pause --reason "why only Michelle can '
            'unblock this"')
    # "I am running out of context" IS NOT A REASON TO PAUSE, and it is
    # the one I reached for three times on 2026-08-03 without once
    # looking at the number. I was at 65%. The session also compacts
    # rather than ending, so it was never a terminal condition at all -
    # at worst the work continues with a summary.
    #
    # It got used because it reads as an external constraint rather than
    # a choice, which is exactly what made it slip past a rule that
    # already bans stopping for budget, for a finished report, or for a
    # rung going green. It cost Michelle a session restart on a premise
    # that was not true.
    #
    # A pause is for handing back something only she can decide. If the
    # context genuinely runs out, the harness deals with it; nothing
    # needs to be paused for that.
    low = reason.lower()
    for word in ("context", "token", "compact", "running low", "out of room"):
        if word in low:
            die("that is not a reason to pause.\n"
                "A pause hands back something only Michelle can decide - "
                "metal, a destructive act, landing on main, or a real "
                "product question. Context is not one of those: the "
                "session compacts rather than ending, so running out is "
                "not a terminal condition, and on 2026-08-03 this reason "
                "was given three times without the number ever being "
                "checked (it was 65%).\n"
                "If there is a real handback, name it. If there is not, "
                "keep going.")
    state = load() or {"cycles": [], "done": None, "fruitless_blocks": 0}
    state["pause"] = {"at": now_iso(), "reason": reason}
    save(state)
    print("paused: %s" % reason)
    print("The Stop gate will let this turn end. Clearing it: begin the "
          "next cycle.")


def cmd_done(args):
    ev = ""
    if "--evidence" in args:
        ev = " ".join(args[args.index("--evidence") + 1:])
    if not ev:
        die('usage: mirror-gate done --evidence "what was watched working, '
            'per section 5"')
    state = load() or {"cycles": [], "pause": None, "fruitless_blocks": 0}
    state["done"] = {"at": now_iso(), "evidence": ev}
    save(state)
    print("done gate met: %s" % ev)


def cmd_status(args):
    state = load()
    if not state:
        print("no Mirror sweep state in this worktree.")
        return
    for c in state["cycles"]:
        marks = {"pass": "+", "fail": "x", "blocked": "!", "n/a": "-",
                 None: " "}
        print("cycle %s [%s] rungs=%s %s" % (c["n"], c["state"], c["rungs"],
                                             c.get("app") or ""))
        for r in c["rows"]:
            print("  %s %-18s %s%s" % (marks[r["result"]], r["id"], r["what"],
                                       (" -- " + r["note"]) if r["note"] else ""))
        for f in c["findings"]:
            print("  . %s" % f["text"])
    if state.get("pause"):
        print("PAUSED: %s" % state["pause"]["reason"])
    if state.get("done"):
        print("DONE: %s" % state["done"]["evidence"])


# --------------------------------------------------------------------------
# The hooks
# --------------------------------------------------------------------------

def block(reason):
    """Exit 2 with the reason on stderr: Claude Code feeds it back."""
    sys.stderr.write(reason + "\n\n" + rules_block() + "\n")
    sys.exit(2)


def cmd_check(args):
    """Stop hook. Exit 0 lets the turn end; exit 2 does not."""
    state = load()
    if not state:
        sys.exit(0)                       # not a Mirror session
    if state.get("done"):
        sys.exit(0)
    if state.get("pause"):
        sys.exit(0)

    state["fruitless_blocks"] = state.get("fruitless_blocks", 0) + 1
    save(state)
    if state["fruitless_blocks"] > MAX_FRUITLESS_BLOCKS:
        sys.stderr.write(
            "mirror-gate: blocked %d times with no row filled and no finding "
            "recorded in between. Standing down rather than wedging the "
            "session -- but this means the loop is not running. Say plainly "
            "what is broken.\n" % (state["fruitless_blocks"] - 1))
        sys.exit(0)

    cycle = open_cycle(state)
    if not cycle:
        last = state["cycles"][-1] if state["cycles"] else None
        where = ("cycle %s is swept but nothing has begun after it."
                 % last["n"]) if last else "no cycle has been opened."
        block("mirror-gate: %s A swept cycle ends the SWEEP, not the work: "
              "triage, patch the blockers plus at most two others, get the "
              "gate green, then `tools/mirror-gate begin <n+1>` and sweep "
              "again -- re-testing the rows you claimed fixed FIRST." % where)

    missing = unpopulated(cycle)
    if missing:
        lines = "\n".join("  [ ] %-18s %s" % (r["id"], r["what"])
                          for r in missing)
        block("mirror-gate: cycle %s is still being swept -- %d row%s has no "
              "result:\n%s\n\nDrive them. Record each with `tools/mirror-gate "
              "row <id> pass|fail|blocked \"what was seen\"`. A blocked row "
              "is a legitimate result and does not end the sweep."
              % (cycle["n"], len(missing), "" if len(missing) == 1 else "s",
                 lines))

    block("mirror-gate: cycle %s has every row filled but is still open. "
          "Close it (`tools/mirror-gate close`), triage, patch, and begin "
          "the next cycle. The mirror is not finished until section 5 is "
          "true -- `tools/mirror-gate done --evidence \"...\"` is the only "
          "way to say that, and `pause --reason` the only way to hand back "
          "to Michelle." % cycle["n"])


def cmd_guard_bash(args):
    """PreToolUse/Bash hook: refuse the paths around the mirror."""
    try:
        payload = json.load(sys.stdin)
    except Exception:
        sys.exit(0)
    command = (payload.get("tool_input") or {}).get("command", "")
    if not command:
        sys.exit(0)
    # The ban is not scoped to the sweep phase: the wire lied about a
    # working capability during a PATCH session too. It lifts only when
    # the run is over.
    state = load()
    if not state or state.get("done"):
        sys.exit(0)

    for pattern, what in FORBIDDEN:
        if re.search(pattern, command, re.I):
            out = {"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason":
                    "mirror-gate: that is %s, not the mirror. If the mirror "
                    "could not do this, THAT is the finding -- record it "
                    "with `tools/mirror-gate finding \"...\"` and keep "
                    "sweeping. (%s)" % (what, LOOP_DOC)}}
            print(json.dumps(out))
            sys.exit(0)
    sys.exit(0)


def die(msg):
    sys.stderr.write("mirror-gate: %s\n" % msg)
    sys.exit(1)


COMMANDS = {
    "begin": cmd_begin, "row": cmd_row, "finding": cmd_finding,
    "close": cmd_close, "pause": cmd_pause, "done": cmd_done,
    "status": cmd_status, "check": cmd_check, "guard-bash": cmd_guard_bash,
}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    fn = COMMANDS.get(argv[1])
    if not fn:
        die("unknown command %r. One of: %s" % (argv[1],
                                                ", ".join(sorted(COMMANDS))))
    return fn(argv[2:]) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
