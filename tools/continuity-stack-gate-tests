#!/usr/bin/env python3
"""Exact mutation tests for the atomic Continuity stack gate."""

from __future__ import annotations

import hashlib
import json
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
GATE = ROOT / "tools/continuity-stack-gate"
COMPATIBILITY = {
    "continuityWire": 4,
    "continuityTable": 9,
    "resident": "1.3",
}


def run(*args: str, root: Path = ROOT):
    return subprocess.run((str(GATE), "--root", str(root), *args),
                          text=True, capture_output=True)


def artifact(root: Path, name: str, component: str, version: str,
             compatibility: dict[str, object] = COMPATIBILITY) -> Path:
    path = root / name
    path.write_bytes((name + " bytes").encode())
    manifest = {
        "schema": 1,
        "component": component,
        "version": version,
        "build": ("a" if component == "application" else "b") * 64,
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "bytes": path.stat().st_size,
        "channel": "development",
        "signed": False,
        "compatibility": compatibility,
    }
    path.with_name(path.name + ".now-update.json").write_text(
        json.dumps(manifest))
    return path


def mini_source(root: Path) -> None:
    files = {
        "contract/continuity_udp.h": (
            "#define NOW_CONTINUITY_VERSION 4u\n"
            "#define NOW_CONTINUITY_STATE_MAGIC 0x4E574331UL /* NWC1 */\n"
            "#define NOW_CONTINUITY_STATE_BYTES 48u\n"
            "#define NOW_CONTINUITY_FLAG_INSIDE 0x0001u\n"
            "#define NOW_CONTINUITY_FLAG_PRIMARY_DOWN 0x0002u\n"
            "#define NOW_CONTINUITY_FLAG_KEEPALIVE 0x0004u\n"
            "#define NOW_CONTINUITY_ACK_MAGIC 0x4E574131UL /* NWA1 */\n"
            "#define NOW_CONTINUITY_ACK_BYTES 44u\n"
            "#define NOW_CONTINUITY_ACK_INACTIVE 0u\n"
            "#define NOW_CONTINUITY_ACK_ARMED 1u\n"
            "#define NOW_CONTINUITY_ACK_ACTIVE 2u\n"
            "#define NOW_CONTINUITY_EXIT_NONE 0u\n"
            "#define NOW_CONTINUITY_EXIT_HOST_LEFT 1u\n"
            "#define NOW_CONTINUITY_EXIT_GUEST_INPUT 2u\n"
            "#define NOW_CONTINUITY_EXIT_LEASE_EXPIRED 3u\n"
            "#define NOW_CONTINUITY_EXIT_DISARMED 4u\n"),
        "contract/peek_table.h": "#define NOW_CONTINUITY_FORMAT_CURRENT 9u\n",
        "contract/resident_version.h": (
            "#define NOW_RESIDENT_VERSION_MAJOR 1\n"
            "#define NOW_RESIDENT_VERSION_MINOR 3\n"),
        "now-host/Sources/Host/ContinuityDatagram.swift": (
            "struct ContinuityStateDatagram {\n"
            "  static let byteCount = 48\n"
            "  static let magic: UInt32 = 0x4E57_4331 // NWC1\n"
            "  static let version: UInt16 = 4\n"
            "  struct Flags {\n"
            "    static let inside = Flags(rawValue: 1 << 0)\n"
            "    static let primaryDown = Flags(rawValue: 1 << 1)\n"
            "    static let keepalive = Flags(rawValue: 1 << 2)\n"
            "  }\n"
            "}\n"
            "struct ContinuityAckDatagram {\n"
            "  static let byteCount = 44\n"
            "  static let magic: UInt32 = 0x4E57_4131 // NWA1\n"
            "  enum State {\n"
            "    case inactive = 0\n"
            "    case armed = 1\n"
            "    case active = 2\n"
            "  }\n"
            "  enum ExitReason {\n"
            "    case none = 0\n"
            "    case hostLeft = 1\n"
            "    case guestInput = 2\n"
            "    case leaseExpired = 3\n"
            "    case disarmed = 4\n"
            "  }\n"
            "}\n"
            "enum ContinuityDatagramError {}\n"),
        "now-host/Sources/Host/ContractMessages.swift": (
            "static let residentTableVersion = 9\n"
            'static let residentVersion = "1.3"\n'),
        "now-guest-ppc/src/input/continuity_intake.c": (
            "NOW_CONTINUITY_FORMAT_CURRENT\n"),
        "ext/src/now_ext_continuity.c": (
            "NOW_CONTINUITY_FORMAT_CURRENT\n"),
        "tools/continuity-probe.py": (
            "from continuity_contract import values\n"
            "def arm():\n"
            "    return {\"type\": \"continuity.arm\", "
            "\"version\": CONTINUITY.version}\n"),
        "tools/emulator-direct-pointer.py": (
            "from continuity_contract import values\n"
            "def arm():\n"
            "    return {\"type\": \"continuity.arm\", "
            "\"version\": CONTINUITY.version}\n"),
    }
    for relative, body in files.items():
        path = root / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)


def main() -> int:
    source = run("source")
    if source.returncode:
        raise AssertionError(source.stderr)

    with tempfile.TemporaryDirectory(prefix="now-continuity-stack-") as tmp:
        directory = Path(tmp)
        app = artifact(directory, "New Old World.bin", "application", "0.2.0")
        ext = artifact(directory, "NOW Extension.bin", "extension", "1.3")
        good = run("verify", "--application", str(app),
                   "--extension", str(ext))
        if good.returncode:
            raise AssertionError(good.stderr)

        old = dict(COMPATIBILITY)
        old["continuityTable"] = 7
        artifact(directory, "NOW Extension.bin", "extension", "1.3", old)
        mismatch = run("verify", "--application", str(app),
                       "--extension", str(ext))
        if mismatch.returncode == 0 or "compatibility" not in mismatch.stderr:
            raise AssertionError("a V9 application plus V7 extension passed")

        artifact(directory, "NOW Extension.bin", "extension", "1.3")
        ext.write_bytes(b"changed after publication")
        changed = run("verify", "--application", str(app),
                      "--extension", str(ext))
        if changed.returncode == 0 or "byte count" not in changed.stderr:
            raise AssertionError("changed extension bytes passed")

    with tempfile.TemporaryDirectory(prefix="now-continuity-source-") as tmp:
        root = Path(tmp)
        mini_source(root)
        coherent = run("source", root=root)
        if coherent.returncode:
            raise AssertionError(coherent.stderr)
        datagram = root / "now-host/Sources/Host/ContinuityDatagram.swift"
        coherent_datagram = datagram.read_text()
        datagram.write_text(coherent_datagram.replace(
            "static let version: UInt16 = 4",
            "static let version: UInt16 = 3"))
        drift = run("source", root=root)
        if drift.returncode == 0 or "host Continuity wire 3" not in drift.stderr:
            raise AssertionError("the exact host-wire drift mutation passed")
        datagram.write_text(coherent_datagram)
        speaker = root / "tools/new-continuity-speaker.py"
        speaker.write_text(
            'def arm():\n    return {"type":"continuity.arm","version":2}\n')
        copied = run("source", root=root)
        if copied.returncode == 0 or "inline control version" not in copied.stderr:
            raise AssertionError("a newly discovered speaker copied wire V2 again")
        speaker.write_text(
            "from continuity_contract import load\n"
            "import struct\n"
            "STATE = struct.Struct(\">IHHIIIIhhIHHIIHH\")\n"
            'def arm():\n    return {"type": "continuity.arm", '
            '"version": CONTINUITY.version}\n')
        layout = run("source", root=root)
        if layout.returncode == 0 or "local state layout" not in layout.stderr:
            raise AssertionError("a newly discovered speaker copied packet layout")

    with tempfile.TemporaryDirectory(prefix="now-continuity-handoff-") as tmp:
        output = Path(tmp) / "existing"
        output.mkdir()
        (output / "yesterdays-extension.bin").write_bytes(b"old")
        reused = subprocess.run((
            str(ROOT / "scripts/build-continuity-stack"),
            "/private/tmp/stable-host", str(output)),
            text=True, capture_output=True)
        if reused.returncode == 0 or "new or empty directory" not in reused.stderr:
            raise AssertionError("a non-empty handoff directory was reused")

    print("continuity stack: 7 compatibility/assembly mutations passed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AssertionError as error:
        print(f"FAILED: {error}")
        raise SystemExit(1)
