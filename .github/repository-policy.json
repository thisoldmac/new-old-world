{
  "repository": "thisoldmac/new-old-world",
  "settings": {
    "allow_merge_commit": false,
    "allow_squash_merge": true,
    "allow_rebase_merge": true,
    "allow_auto_merge": true,
    "delete_branch_on_merge": true
  },
  "code_qa": {
    "required_status_checks": [
      "Emulator QA",
      "Metal QA"
    ],
    "human_override_actors": [
      "mishyjari"
    ],
    "product_code": {
      "path_prefixes": [
        "contract/",
        "ext/",
        "now-guest-68k/",
        "now-guest-ppc/",
        "now-host/",
        "web-bridge/"
      ],
      "exact_paths": [
        "product/features.yaml"
      ]
    }
  },
  "ruleset": {
    "name": "Protected main",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "required_linear_history"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": [
            "squash",
            "rebase"
          ]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "required_status_checks": [
            {
              "context": "Documentation"
            },
            {
              "context": "Native guest tests"
            },
            {
              "context": "Host suites and app builds"
            },
            {
              "context": "No lab configuration in the tree"
            },
            {
              "context": "Emulator QA"
            },
            {
              "context": "Metal QA"
            }
          ],
          "strict_required_status_checks_policy": false
        }
      }
    ]
  }
}
