{
  "openapi": "3.1.0",
  "info": {
    "title": "New Old World API",
    "version": "1.0.0",
    "summary": "The first public, client-neutral API for New Old World"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    { "url": "http://127.0.0.1:{port}/api/v1", "variables": { "port": { "default": "19870" } } }
  ],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/": {
      "get": {
        "operationId": "api.identity",
        "responses": {
          "200": { "$ref": "#/components/responses/APIIdentity" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/operations": {
      "get": {
        "operationId": "operations.list",
        "responses": {
          "200": { "$ref": "#/components/responses/OperationCatalog" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/operations/{operationID}": {
      "parameters": [
        { "name": "operationID", "in": "path", "required": true,
          "schema": { "type": "string", "enum": [
            "catalog.search", "diagnostics.capture", "diagnostics.framebuffer", "diagnostics.transfer",
            "files.capabilities", "files.reveal", "guests.capabilities", "guests.census", "guests.facts",
            "interface.control.act", "interface.menu.act", "interface.observe", "interface.text.get", "interface.text.set", "interface.window.act",
            "logs.guest.tail", "logs.host.tail", "mirror.act", "mirror.find", "mirror.journal", "mirror.lifecycle", "mirror.metrics", "mirror.snapshot", "mirror.start", "mirror.status", "mirror.wait", "mirror.waitForSettlement",
            "processes.activate", "processes.list", "processes.quit", "screen.capture", "screen.stream", "software.launch", "software.list"
          ] } }
      ],
      "post": {
        "operationId": "operations.invoke",
        "summary": "Invoke one projection-backed public operation",
        "description": "The operation is admitted only when its neutral catalog adjudication is public. Agent-only conveniences and MCP compositions are never reachable here.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericOperationInvocation" } } } },
        "responses": {
          "200": { "description": "A typed neutral operation outcome", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericOperationResult" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "events.watch",
        "summary": "Watch live public change hints",
        "description": "Live-only Server-Sent Events with bounded buffering. Events are refetch hints, not replacement state. Replay cursors and Last-Event-ID are rejected; after every reconnect, refetch the named resources before trusting local state.",
        "parameters": [
          { "name": "Accept", "in": "header", "required": true, "schema": { "type": "string", "const": "text/event-stream" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/EventStream" },
          "406": { "$ref": "#/components/responses/BadRequest" },
          "409": { "description": "Replay was requested, but v1 is live-only", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/guests": {
      "get": {
        "operationId": "guests.list",
        "responses": {
          "200": { "$ref": "#/components/responses/GuestList" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/guests/{guestID}": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "get": {
        "operationId": "guests.status",
        "responses": {
          "200": { "$ref": "#/components/responses/GuestDetail" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/guests/{guestID}/commands": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "post": {
        "operationId": "commands.execute",
        "parameters": [{ "$ref": "#/components/parameters/ExpectedGuestSession" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsoleCommandRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ConsoleCommandResult" },
          "400": { "$ref": "#/components/responses/ConsoleCommandResult" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/guests/{guestID}/files": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "get": {
        "operationId": "files.list",
        "parameters": [
          { "name": "path", "in": "query", "schema": { "$ref": "#/components/schemas/GuestFilePath" } },
          { "name": "cursor", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": { "200": { "description": "A bounded guest file listing" } }
      }
    },
    "/guests/{guestID}/files/stat": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "get": {
        "operationId": "files.stat",
        "parameters": [{ "name": "path", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/GuestFilePath" } }],
        "responses": { "200": { "description": "An exact guest file observation" } }
      }
    },
    "/guests/{guestID}/files/mutations": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "post": {
        "operationId": "files.mutate",
        "parameters": [{ "$ref": "#/components/parameters/ExpectedGuestSession" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestFileMutation" } } } },
        "responses": { "200": { "description": "A typed guest file mutation receipt" } }
      }
    },
    "/guests/{guestID}/transfers/uploads": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "post": {
        "operationId": "files.put",
        "parameters": [{ "$ref": "#/components/parameters/ExpectedGuestSession" }],
        "description": "Admits one private upload stage. Send sequential raw chunks with PUT /transfers/{transferID}/content; HTTP Transfer-Encoding chunked is not supported.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadAdmission" } } } },
        "responses": { "201": { "description": "A staging transfer resource" }, "413": { "description": "The declared file exceeds 32 MiB" } }
      }
    },
    "/guests/{guestID}/transfers/downloads": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "post": {
        "operationId": "files.get",
        "parameters": [{ "$ref": "#/components/parameters/ExpectedGuestSession" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "path": { "$ref": "#/components/schemas/GuestFilePath" } }, "required": ["path"], "additionalProperties": false } } } },
        "responses": { "200": { "description": "A settled download transfer resource" } }
      }
    },
    "/transfers": {
      "get": { "operationId": "transfers.list", "responses": { "200": { "description": "Transfers known to this host launch" } } }
    },
    "/transfers/{transferID}": {
      "parameters": [{ "$ref": "#/components/parameters/TransferID" }],
      "get": { "operationId": "transfers.get", "responses": { "200": { "description": "One transfer resource" } } },
      "delete": { "operationId": "transfers.cancel", "responses": { "200": { "description": "Cancellation requested or an already settled transfer" } } }
    },
    "/transfers/{transferID}/content": {
      "parameters": [{ "$ref": "#/components/parameters/TransferID" }],
      "put": {
        "operationId": "transfers.uploadChunk",
        "description": "Appends one sequential raw chunk to a private upload stage. This is application-level chunking across bounded requests, not HTTP Transfer-Encoding chunked.",
        "parameters": [{ "name": "offset", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 0 } }],
        "requestBody": { "required": true, "content": { "application/octet-stream": { "schema": { "type": "string", "contentEncoding": "binary", "maxLength": 8192 } } } },
        "responses": { "200": { "description": "Updated staging transfer" } }
      },
      "get": { "operationId": "transfers.content", "responses": { "200": { "description": "Completed download bytes" }, "409": { "description": "Content is not complete" } } }
    },
    "/transfers/{transferID}/commit": {
      "parameters": [{ "$ref": "#/components/parameters/TransferID" }],
      "post": { "operationId": "transfers.commit", "responses": { "200": { "description": "Settled upload transfer" } } }
    },
    "/listener": {
      "get": {
        "operationId": "listener.status",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      },
      "put": {
        "operationId": "listener.start",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      },
      "delete": {
        "operationId": "listener.stop",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      }
    },
    "/connections": {
      "get": {
        "operationId": "connections.list",
        "responses": { "200": { "$ref": "#/components/responses/ConnectionList" } }
      }
    },
    "/connections/{sessionID}": {
      "parameters": [{ "$ref": "#/components/parameters/SessionID" }],
      "delete": {
        "operationId": "connections.disconnect",
        "responses": {
          "200": { "$ref": "#/components/responses/OperationResult" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "GuestID": {
        "name": "guestID", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "SessionID": {
        "name": "sessionID", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 38, "maxLength": 180 }
      },
      "TransferID": {
        "name": "transferID", "in": "path", "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "ExpectedGuestSession": {
        "name": "X-NOW-Guest-Session", "in": "header", "required": true,
        "description": "Exact session observed immediately before an unsafe stable-guest operation. A replacement session returns 409 before dispatch.",
        "schema": { "type": "string", "minLength": 38, "maxLength": 180 }
      }
    },
    "responses": {
      "APIIdentity": {
        "description": "API identity and contract digest",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/APIIdentity" } } }
      },
      "OperationCatalog": {
        "description": "Runtime-bound client-neutral operation catalog",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationCatalog" } } }
      },
      "GuestList": {
        "description": "Remembered guests with live session state",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestList" } } }
      },
      "GuestDetail": {
        "description": "Guest identity, status, and observed capabilities",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestDetail" } } }
      },
      "ListenerStatus": {
        "description": "Guest listener state",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListenerStatus" } } }
      },
      "ConnectionList": {
        "description": "Exact live guest sessions",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionList" } } }
      },
      "EventStream": {
        "description": "A live-only stream. Heartbeat comments carry no state. On stream.ready, stream.resync-required, or reconnect, refetch the listed resources; v1 retains no replay log.",
        "headers": {
          "Cache-Control": { "schema": { "type": "string", "const": "no-store" } }
        },
        "content": {
          "text/event-stream": {
            "schema": { "$ref": "#/components/schemas/PublicEvent" }
          }
        }
      },
      "ConsoleCommandResult": {
        "description": "Bounded result from the exact addressed guest session",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsoleCommandResult" } } }
      },
      "OperationResult": {
        "description": "Typed operation result",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationResult" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid X-API-Key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "BadRequest": {
        "description": "The request is malformed or unsafe",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "The addressed API resource does not exist",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "A host-issued local application key. MCP authentication is a separate protocol concern."
      }
    },
    "schemas": {
      "APIIdentity": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "const": "New Old World API" },
          "apiMajor": { "type": "integer", "const": 1 },
          "schemaRevision": { "type": "integer", "minimum": 1 },
          "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operations": { "type": "string", "const": "/api/v1/operations" },
          "limits": {
            "type": "object",
            "properties": {
              "maximumHeaderBytes": { "type": "integer", "minimum": 1 },
              "maximumRequestBodyBytes": { "type": "integer", "minimum": 1 }
            },
            "required": ["maximumHeaderBytes", "maximumRequestBodyBytes"],
            "additionalProperties": false
          }
        },
        "required": ["name", "apiMajor", "schemaRevision", "contractDigest", "operations", "limits"],
        "additionalProperties": false
      },
      "OperationCatalog": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationId": { "type": "string", "minLength": 3, "maxLength": 128 },
                "available": { "type": "boolean", "const": true },
                "rendering": { "type": "string", "enum": ["resource", "generic"] },
                "title": { "type": "string" },
                "summary": { "type": "string" },
                "inputSchema": { "type": "object" },
                "effect": { "type": "string", "enum": ["read", "boundedMutation", "disruptiveMutation", "bulkTransfer"] },
                "addressing": { "type": "string", "enum": ["hostWide", "stableOrSessionGuest", "exactGuestSession"] },
                "capability": { "type": "string" }
              },
              "required": ["operationId", "available"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operations"],
        "additionalProperties": false
      },
      "GuestList": {
        "type": "object",
        "properties": {
          "guests": { "type": "array", "items": { "$ref": "#/components/schemas/GuestSummary" } }
        },
        "required": ["guests"],
        "additionalProperties": false
      },
      "GuestDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "displayName": { "type": "string" },
          "connected": { "type": "boolean" },
          "connectedAt": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "build": { "type": "string" },
          "operatingSystem": { "type": "string" },
          "agentAccess": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "displayName", "connected", "name", "capabilities"],
        "additionalProperties": false
      },
      "ConnectionList": {
        "type": "object",
        "properties": {
          "connections": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectionSummary" } }
        },
        "required": ["connections"],
        "additionalProperties": false
      },
      "PublicEventGuest": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 40 },
          "sessionId": { "type": "string", "minLength": 38, "maxLength": 180 }
        },
        "required": ["id", "sessionId"],
        "additionalProperties": false
      },
      "PublicEvent": {
        "type": "object",
        "description": "A privacy-reviewed invalidation hint. No host path, URL, private enum value, or guest-supplied diagnostic string is present.",
        "properties": {
          "type": { "type": "string", "enum": ["stream.ready", "stream.resync-required", "guest.connected", "guest.disconnected", "guest.changed", "guests.changed", "listener.changed", "transfer.progressed", "transfers.changed", "files.changed", "processes.changed"] },
          "guest": { "$ref": "#/components/schemas/PublicEventGuest" },
          "receivedBytes": { "type": "integer", "minimum": 0 },
          "expectedBytes": { "type": "integer", "minimum": 0 },
          "liveOnly": { "type": "boolean" },
          "replay": { "type": "boolean" },
          "refetch": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/api/v1/" } }
        },
        "required": ["type", "refetch"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "error"],
        "additionalProperties": false
      },
      "APIVersion": {
        "type": "object",
        "properties": {
          "major": { "type": "integer", "const": 1 },
          "schemaRevision": { "type": "integer", "minimum": 1 },
          "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["major", "schemaRevision", "contractDigest"],
        "additionalProperties": false
      },
      "GuestAddress": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "OperationDisposition": {
        "type": "string",
        "enum": ["completed", "refused", "unavailable", "failed", "cancelled"]
      },
      "OperationError": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 96 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "reach": { "type": "string", "enum": ["request", "host", "guest", "session", "resource"] }
        },
        "required": ["code", "message", "reach"],
        "additionalProperties": false
      },
      "OperationResult": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "minLength": 3, "maxLength": 128 },
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "disposition": { "$ref": "#/components/schemas/OperationDisposition" },
          "value": { "type": "object" },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "operationId", "disposition"],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "completed" } } },
            "then": { "required": ["value"], "not": { "required": ["error"] } },
            "else": { "required": ["error"], "not": { "required": ["value"] } }
          }
        ],
        "additionalProperties": false
      },
      "GuestSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "displayName": { "type": "string" },
          "connected": { "type": "boolean" },
          "connectedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "displayName", "connected"],
        "additionalProperties": false
      },
      "ListenerStatus": {
        "type": "object",
        "properties": {
          "state": { "type": "string", "enum": ["idle", "listening", "connected", "failed"] },
          "desiredPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "boundPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "failure": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["state", "desiredPorts", "boundPorts"],
        "additionalProperties": false
      },
      "ConnectionSummary": {
        "type": "object",
        "properties": {
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "connectedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["guest", "connectedAt"],
        "additionalProperties": false
      },
      "ConsoleCommandRequest": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string", "minLength": 1, "maxLength": 96,
            "pattern": "^[A-Za-z0-9._-]+$", "x-now-maximumUTF8Bytes": 96
          },
          "arguments": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "minLength": 1, "maxLength": 96,
              "x-now-maximumUTF8Bytes": 96
            },
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "maxLength": 4096, "x-now-maximumUTF8Bytes": 4096 },
                { "type": "integer" },
                { "type": "boolean" }
              ]
            }
          },
          "argumentLine": {
            "type": "string", "maxLength": 4096,
            "x-now-maximumUTF8Bytes": 4096
          }
        },
        "required": ["command"],
        "oneOf": [
          { "required": ["arguments"], "not": { "required": ["argumentLine"] } },
          { "required": ["argumentLine"], "not": { "required": ["arguments"] } },
          { "not": { "anyOf": [{ "required": ["arguments"] }, { "required": ["argumentLine"] }] } }
        ],
        "additionalProperties": false
      },
      "ConsoleCommandDisposition": {
        "type": "string",
        "enum": ["completed", "invalid", "unadvertised", "timed-out", "disconnected", "refused", "failed"]
      },
      "ConsoleCommandResult": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "const": "commands.execute" },
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "disposition": { "$ref": "#/components/schemas/ConsoleCommandDisposition" },
          "value": {
            "type": "object",
            "properties": {
              "output": { "type": "object" },
              "outputObjects": { "type": "object" }
            },
            "additionalProperties": false,
            "x-now-maximumEncodedBytes": 65536
          },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "operationId", "guest", "disposition"],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "completed" } } },
            "then": { "required": ["value"], "not": { "required": ["error"] } },
            "else": { "required": ["error"], "not": { "required": ["value"] } }
          }
        ],
        "additionalProperties": false
      },
      "TransferSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "guestID": { "type": "string" },
          "guestSessionID": { "type": "string" },
          "direction": { "type": "string", "enum": ["upload", "download"] },
          "guestPath": { "$ref": "#/components/schemas/GuestFilePath" },
          "state": { "type": "string", "enum": ["staging", "running", "completed", "failed", "cancelled", "expired"] },
          "transferredBytes": { "type": "integer", "minimum": 0 },
          "expectedBytes": { "type": "integer", "minimum": 0, "maximum": 33554432 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "contentAvailable": { "type": "boolean" },
