{
  "openapi": "3.1.0",
  "info": {
    "title": "New Old World API",
    "version": "1.0.0",
    "summary": "The first public, client-neutral API for New Old World"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    { "url": "http://127.0.0.1:{port}/api/v1", "variables": { "port": { "default": "19870" } } }
  ],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/": {
      "get": {
        "operationId": "api.identity",
        "responses": {
          "200": { "$ref": "#/components/responses/APIIdentity" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/operations": {
      "get": {
        "operationId": "operations.list",
        "responses": {
          "200": { "$ref": "#/components/responses/OperationCatalog" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/guests": {
      "get": {
        "operationId": "guests.list",
        "responses": {
          "200": { "$ref": "#/components/responses/GuestList" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/guests/{guestID}": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "get": {
        "operationId": "guests.status",
        "responses": {
          "200": { "$ref": "#/components/responses/GuestDetail" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/guests/{guestID}/commands": {
      "parameters": [{ "$ref": "#/components/parameters/GuestID" }],
      "post": {
        "operationId": "commands.execute",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConsoleCommandRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/ConsoleCommandResult" },
          "400": { "$ref": "#/components/responses/ConsoleCommandResult" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/listener": {
      "get": {
        "operationId": "listener.status",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      },
      "put": {
        "operationId": "listener.start",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      },
      "delete": {
        "operationId": "listener.stop",
        "responses": { "200": { "$ref": "#/components/responses/ListenerStatus" } }
      }
    },
    "/connections": {
      "get": {
        "operationId": "connections.list",
        "responses": { "200": { "$ref": "#/components/responses/ConnectionList" } }
      }
    },
    "/connections/{sessionID}": {
      "parameters": [{ "$ref": "#/components/parameters/SessionID" }],
      "delete": {
        "operationId": "connections.disconnect",
        "responses": {
          "200": { "$ref": "#/components/responses/OperationResult" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "GuestID": {
        "name": "guestID", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "SessionID": {
        "name": "sessionID", "in": "path", "required": true,
        "schema": { "type": "string", "minLength": 38, "maxLength": 180 }
      }
    },
    "responses": {
      "APIIdentity": {
        "description": "API identity and contract digest",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/APIIdentity" } } }
      },
      "OperationCatalog": {
        "description": "Runtime-bound client-neutral operation catalog",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationCatalog" } } }
      },
      "GuestList": {
        "description": "Remembered guests with live session state",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestList" } } }
      },
      "GuestDetail": {
        "description": "Guest identity, status, and observed capabilities",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestDetail" } } }
      },
      "ListenerStatus": {
        "description": "Guest listener state",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListenerStatus" } } }
      },
      "ConnectionList": {
        "description": "Exact live guest sessions",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionList" } } }
      },
      "ConsoleCommandResult": {
        "description": "Bounded result from the exact addressed guest session",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsoleCommandResult" } } }
      },
      "OperationResult": {
        "description": "Typed operation result",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationResult" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid X-API-Key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "BadRequest": {
        "description": "The request is malformed or unsafe",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "NotFound": {
        "description": "The addressed API resource does not exist",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "A host-issued local application key. MCP authentication is a separate protocol concern."
      }
    },
    "schemas": {
      "APIIdentity": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "const": "New Old World API" },
          "apiMajor": { "type": "integer", "const": 1 },
          "schemaRevision": { "type": "integer", "minimum": 1 },
          "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operations": { "type": "string", "const": "/api/v1/operations" },
          "limits": {
            "type": "object",
            "properties": {
              "maximumHeaderBytes": { "type": "integer", "minimum": 1 },
              "maximumRequestBodyBytes": { "type": "integer", "minimum": 1 }
            },
            "required": ["maximumHeaderBytes", "maximumRequestBodyBytes"],
            "additionalProperties": false
          }
        },
        "required": ["name", "apiMajor", "schemaRevision", "contractDigest", "operations", "limits"],
        "additionalProperties": false
      },
      "OperationCatalog": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationId": { "type": "string", "minLength": 3, "maxLength": 128 },
                "available": { "type": "boolean", "const": true }
              },
              "required": ["operationId", "available"],
              "additionalProperties": false
            }
          }
        },
        "required": ["operations"],
        "additionalProperties": false
      },
      "GuestList": {
        "type": "object",
        "properties": {
          "guests": { "type": "array", "items": { "$ref": "#/components/schemas/GuestSummary" } }
        },
        "required": ["guests"],
        "additionalProperties": false
      },
      "GuestDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "displayName": { "type": "string" },
          "connected": { "type": "boolean" },
          "connectedAt": { "type": "string", "format": "date-time" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "build": { "type": "string" },
          "operatingSystem": { "type": "string" },
          "agentAccess": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "displayName", "connected", "name", "capabilities"],
        "additionalProperties": false
      },
      "ConnectionList": {
        "type": "object",
        "properties": {
          "connections": { "type": "array", "items": { "$ref": "#/components/schemas/ConnectionSummary" } }
        },
        "required": ["connections"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "error"],
        "additionalProperties": false
      },
      "APIVersion": {
        "type": "object",
        "properties": {
          "major": { "type": "integer", "const": 1 },
          "schemaRevision": { "type": "integer", "minimum": 1 },
          "contractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["major", "schemaRevision", "contractDigest"],
        "additionalProperties": false
      },
      "GuestAddress": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "OperationDisposition": {
        "type": "string",
        "enum": ["completed", "refused", "unavailable", "failed", "cancelled"]
      },
      "OperationError": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 96 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "reach": { "type": "string", "enum": ["request", "host", "guest", "session", "resource"] }
        },
        "required": ["code", "message", "reach"],
        "additionalProperties": false
      },
      "OperationResult": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "minLength": 3, "maxLength": 128 },
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "disposition": { "$ref": "#/components/schemas/OperationDisposition" },
          "value": { "type": "object" },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "operationId", "disposition"],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "completed" } } },
            "then": { "required": ["value"], "not": { "required": ["error"] } },
            "else": { "required": ["error"], "not": { "required": ["value"] } }
          }
        ],
        "additionalProperties": false
      },
      "GuestSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "sessionId": { "type": "string" },
          "displayName": { "type": "string" },
          "connected": { "type": "boolean" },
          "connectedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "displayName", "connected"],
        "additionalProperties": false
      },
      "ListenerStatus": {
        "type": "object",
        "properties": {
          "state": { "type": "string", "enum": ["idle", "listening", "connected", "failed"] },
          "desiredPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "boundPorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "failure": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["state", "desiredPorts", "boundPorts"],
        "additionalProperties": false
      },
      "ConnectionSummary": {
        "type": "object",
        "properties": {
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "connectedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["guest", "connectedAt"],
        "additionalProperties": false
      },
      "ConsoleCommandRequest": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string", "minLength": 1, "maxLength": 96,
            "pattern": "^[A-Za-z0-9._-]+$", "x-now-maximumUTF8Bytes": 96
          },
          "arguments": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "minLength": 1, "maxLength": 96,
              "x-now-maximumUTF8Bytes": 96
            },
            "additionalProperties": {
              "oneOf": [
                { "type": "string", "maxLength": 4096, "x-now-maximumUTF8Bytes": 4096 },
                { "type": "integer" },
                { "type": "boolean" }
              ]
            }
          },
          "argumentLine": {
            "type": "string", "maxLength": 4096,
            "x-now-maximumUTF8Bytes": 4096
          }
        },
        "required": ["command"],
        "oneOf": [
          { "required": ["arguments"], "not": { "required": ["argumentLine"] } },
          { "required": ["argumentLine"], "not": { "required": ["arguments"] } },
          { "not": { "anyOf": [{ "required": ["arguments"] }, { "required": ["argumentLine"] }] } }
        ],
        "additionalProperties": false
      },
      "ConsoleCommandDisposition": {
        "type": "string",
        "enum": ["completed", "invalid", "unadvertised", "timed-out", "disconnected", "refused", "failed"]
      },
      "ConsoleCommandResult": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "operationId": { "type": "string", "const": "commands.execute" },
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "disposition": { "$ref": "#/components/schemas/ConsoleCommandDisposition" },
          "value": {
            "type": "object",
            "properties": {
              "output": { "type": "object" },
              "outputObjects": { "type": "object" }
            },
            "additionalProperties": false,
            "x-now-maximumEncodedBytes": 65536
          },
          "error": { "$ref": "#/components/schemas/OperationError" }
        },
        "required": ["requestId", "operationId", "guest", "disposition"],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "completed" } } },
            "then": { "required": ["value"], "not": { "required": ["error"] } },
            "else": { "required": ["error"], "not": { "required": ["value"] } }
          }
        ],
        "additionalProperties": false
      },
      "TransferSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "guest": { "$ref": "#/components/schemas/GuestAddress" },
          "direction": { "type": "string", "enum": ["upload", "download"] },
          "state": { "type": "string", "enum": ["staging", "queued", "running", "completed", "failed", "cancelled"] },
          "bytesCompleted": { "type": "integer", "minimum": 0 },
          "bytesTotal": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "guest", "direction", "state", "bytesCompleted"],
        "additionalProperties": false
      }
    }
  },
  "x-now-compatibility": {
    "apiMajor": 1,
    "schemaRevision": 2,
    "policy": "Additive optional fields and operations may ship within v1; required-field meaning and disposition semantics remain stable."
  },
  "x-now-operation-catalog": [
    "api.identity", "catalog.search", "commands.execute", "connections.disconnect", "connections.list", "diagnostics.capture", "diagnostics.framebuffer", "diagnostics.transfer",
    "files.capabilities", "files.get", "files.list", "files.mutate", "files.put", "files.reveal", "files.stat",
    "guests.capabilities", "guests.census", "guests.facts", "guests.list", "guests.status",
    "interface.control.act", "interface.menu.act", "interface.observe", "interface.text.get", "interface.text.set", "interface.window.act",
    "listener.start", "listener.status", "listener.stop", "logs.guest.tail", "logs.host.tail",
    "mirror.act", "mirror.find", "mirror.journal", "mirror.lifecycle", "mirror.metrics", "mirror.snapshot", "mirror.start", "mirror.status", "mirror.wait", "mirror.waitForSettlement",
    "operations.list", "processes.activate", "processes.list", "processes.quit",
    "screen.capture", "screen.stream", "software.launch", "software.list", "transfers.cancel"
  ]
}
