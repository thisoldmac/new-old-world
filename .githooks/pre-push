#!/bin/sh
# GitHub's ruleset is authoritative. This local half fails immediately, before
# transport, when an old command or muscle memory tries to update main.
blocked=0
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "[protected-main] refusing direct push to $remote_ref." >&2
            echo "  Push a dev/<domain>/<slug> branch and merge its pull request." >&2
            echo "  Local main follows GitHub only: tools/sync-main" >&2
            blocked=1
            ;;
    esac
done
exit "$blocked"
