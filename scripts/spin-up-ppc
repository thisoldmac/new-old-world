#!/usr/bin/env bash
# Put the NOW Extension and the PowerPC guest on a fresh emulator clone,
# COLD-reboot so the INIT loads, and make the guest say whether it did.
#
#     scripts/spin-up-ppc                  # headless: stage, reboot, verify
#     NOW_SPIN_DISPLAY=1 scripts/spin-up-ppc   # with a cocoa window
#
# This is the missing half of scripts/build-guests. That script builds
# ext/; until tools/stage-ext.py and this file, nothing installed it, so
# the three planes that live in the INIT (P1 anchors, P3 content, P4 act)
# were resident on no machine anywhere and `actselftest` — the act plane's
# only ABI oracle — had never been run.
#
# EMULATOR ONLY. The lab checkout beside this one owns the emulator, the
# QMP tool and the anchor-worker client; they are INSTRUMENTS borrowed to
# drive a deploy and NOW ships none of them. Nothing here touches physical
# hardware and this is not a route to doing so — scripts/deploy-68k is the
# metal path, and it is attended.
#
# THE FOUR RULES THIS ENCODES, each measured, none negotiable:
#
#   1. AN INIT LOADS AT BOOT ONLY, and OS 9 ignores QMP `system_powerdown`.
#      The guest must therefore shut ITSELF down before the relaunch
#      without -loadvm. A QMP `quit` is a power cut: it sets the
#      unclean-volume bit and makes Disk First Aid part of the next boot.
#      It cannot be asked through the human interface — QMP keyboard
#      events never reach this guest, there is no absolute pointer, and a
#      posted click cannot select from a menu — and the canonical anchor
#      worker has no `script` verb to ask the Finder with. So NOW stages
#      its own applet (tools/guest-shutdown) and launches it:
#      tools/shutdown-guest.py.
#   2. GIVE THE VOLUME TIME TO FLUSH, through a guest-clean shutdown rather
#      than elapsed host time. The re-verify after the reboot remains the
#      second guardrail: if the writes never reached the qcow2, this fails
#      loudly instead of testing yesterday's bytes.
#   3. SESSION-PRIVATE CLONE, ALWAYS. tbt_clone_disk (APFS cp -c) is
#      instant and free, and it is what lets parallel sessions run without
#      image-lock collisions. The shared base stays pristine.
#   4. COLLISION-SAFE PORTS. Another session may hold any given one, so
#      probe and advance rather than attach to whatever answers.
#   5. TEAR DOWN WHAT YOU STARTED, BY PATH - NOT WITH tools/stop.
#      Rule 3 makes the run directory session-private via NOW_SPIN_RUN.
#      The lab's tools/stop DOES NOT KNOW THAT VARIABLE: it derives its
#      run directory from TIMBOTTU_RUN_ROOT/--instance and otherwise
#      cleans $LAB/run. So `tools/stop` after a NOW_SPIN_RUN spin-up
#      does not stop your VM, and it DOES delete another session's
#      remnants out of the shared checkout - watched 2026-08-06, when it
#      removed a stale run/overlay.qcow2 there. It reported no VM
#      running against it, so that instance was probably harmless; the
#      shape is not. It is the exact hazard rule 3 exists to prevent,
#      arriving at teardown instead of at boot.
#      Stop yours the way it was started: QMP `quit` on
#      "$NOW_SPIN_RUN/qmp.sock" (or tools/shutdown-guest.py for a clean
#      volume - see rule 1), then remove that directory. Never by port:
#      lsof -ti tcp:<wire> matches QEMU itself under user-mode
#      networking, so killing by port kills the VM, and possibly not
#      yours.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOW="$(cd "$HERE/.." && pwd)"
# The lab checkout is normally NOW's parent — but not from a worktree, which
# sits several levels deeper (now/.claude/worktrees/<branch>) and whose parent
# is a scratch directory with no tools/ in it. That failed with a bare
# "tools/lib.sh: No such file or directory", which reads like a broken lab
# install rather than the wrong starting point. So walk up to the checkout
# that actually has the instruments.
LAB="${NOW_LAB_ROOT:-}"
if [ -z "$LAB" ]; then
    LAB="$NOW"
    while [ "$LAB" != / ] && [ ! -f "$LAB/tools/lib.sh" ]; do
        LAB="$(dirname "$LAB")"
    done
fi
[ -f "$LAB/tools/lib.sh" ] || {
    echo "no lab checkout above $NOW (set NOW_LAB_ROOT to the TimBotTu clone)"
    exit 1
}
cd "$LAB"                                  # lib.sh and tools/qmp are lab-relative
. tools/lib.sh

QEMU="${TIMBOTTU_QEMU:-$LAB/qemu/build/qemu-system-ppc}"
BASE="${NOW_SPIN_BASE:-$HOME/Lab/Assets/os91-qemu/os91-runner.qcow2}"
# A PER-VM RUN DIRECTORY, for the same reason rule 4 makes the ports
# per-VM. It was one fixed directory, so a second spin-up in the same
# checkout bound the same socket NAMES: the newer QEMU took them, every
# `tools/qmp` afterwards reached the WRONG machine, and when the older
# one exited it unlinked the files out from under the survivor - which
# then had no control channel at all and could not even be told to quit.
# Watched on 2026-08-03; it cost the A-B screendump channel mid-drive.
#
# The directory and not just the socket, because the lab's launcher
# derives qmp-ui.sock from qmp.sock's DIRNAME with a fixed name, and the
# lab is an instrument this repo does not get to edit.
#
# THE DEFAULT DOES NOT FIT FROM A WORKTREE, which is where agents work.
# A UNIX socket path is capped at 104 bytes, and
# now/.claude/worktrees/<branch>/run/<pid>/qmp-ui.sock spends 108 of them
# before the sock file is named. QEMU refuses to start and says so in
# run/<pid>/qemu.log — but the script's own output ends after "boot a
# fresh, session-private clone" with no error, so it reads as a boot that
# hung rather than one that never began. Checked here instead, with the
# cure in the message.
RUN="${NOW_SPIN_RUN:-$NOW/run/$$}"
if [ "${#RUN}" -gt 80 ]; then
    echo "run directory is too deep for a UNIX socket: $RUN" >&2
    echo "  (${#RUN} bytes; qmp-ui.sock needs the whole path under 104)" >&2
    echo "  set NOW_SPIN_RUN to something short, e.g." >&2
    echo "  NOW_SPIN_RUN=/private/tmp/nowvm-\$\$ $0" >&2
    exit 78
fi
DISK="$RUN/session.qcow2"
QMP="$RUN/qmp.sock"

# Build products live outside the repository and are keyed to THIS
# checkout, exactly as scripts/build-guests keys them, so many worktrees
# can run at once without sharing a CMake cache.
OUT="${TMPDIR:-/tmp}/now-guest-builds/$(printf '%s' "$NOW" | shasum | cut -c1-12)"
EXT_BIN="${NOW_EXT_BIN:-$OUT/ext/NowExt.bin}"
APP_BIN="${NOW_APP_BIN:-$OUT/ppc/New Old World.bin}"
SHUTDOWN_BIN="${NOW_SHUTDOWN_BIN:-$OUT/shutdown/NowShutDown.bin}"

[ -x "$QEMU" ] || { echo "no qemu-system-ppc at $QEMU (set TIMBOTTU_QEMU)"; exit 1; }
[ -f "$BASE" ] || { echo "no base image at $BASE (set NOW_SPIN_BASE)"; exit 1; }
[ -f "$EXT_BIN" ] || { echo "no NowExt.bin at $EXT_BIN — run scripts/build-guests 68k"; exit 1; }
[ -f "$APP_BIN" ] || { echo "no guest app at $APP_BIN — run scripts/build-guests ppc"; exit 1; }
# Checked HERE, before a 150-second boot, and not at the shutdown step
# three minutes in. Without this applet the machine cannot be asked to go
# down cleanly at all, and the run would get all the way to the reboot
# before finding out.
[ -f "$SHUTDOWN_BIN" ] || { echo "no NowShutDown.bin at $SHUTDOWN_BIN — run \
scripts/build-guests 68k (it is what asks the guest to shut itself down)"; exit 1; }

export TBT_MACHINE_PROFILE=mac99
tbt_select_machine_profile mac99
mkdir -p "$RUN"

# --- WHICH RIG IS THIS? Said out loud, before anything boots -------------
# On 2026-08-06 a coordinating session told the human an arc's measurements
# were suspect because the shared stage image was stale. Two things were
# wrong with that and BOTH were visible in this file:
#
#   * BASE above defaults to os91-runner.qcow2, NOT now-mirror-stage.qcow2.
#     This script does not use the stage image unless asked to.
#   * It stages THIS CHECKOUT's ext and app into the clone and cold-boots,
#     so the resident under test is the tree's build either way.
#
# Neither fact was hidden; both were quiet — one line defaulting a shell
# variable. The cure for a quiet fact that a careful reader got wrong is
# not more care, it is volume. So every run now prints its provenance and
# writes it into the run directory, and any document quoting a result from
# this rig can name it by copying $RUN/provenance.md rather than by
# remembering. The sweep that got this right did it by hand
# (docs/fidelity-sweep-2026-08-07-a.md); the next one should not have to.
STAGED_JSON="$RUN/staged.json"
python3 - "$STAGED_JSON" "$NOW" "$EXT_BIN" "$APP_BIN" "$OUT" <<'PY'
import json, os, re, subprocess, sys
out_path, now, ext_bin, app_bin, out = sys.argv[1:6]
def git(*a):
    try:
        return subprocess.run(["git", "-C", now, *a], capture_output=True,
                              text=True, check=True).stdout.strip()
    except Exception:
        return None
ident = os.path.join(out, "ext", "now_ext_identity.r")
source = build = None
try:
    hexes = re.search(r'\$"([0-9a-f]+)"', open(ident).read().replace("\r", "\n"))
    if hexes:
        source, build = hexes.group(1)[:40], hexes.group(1)[40:80]
except Exception:
    pass
json.dump({
    "tree": now,
    "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
    "commit": git("rev-parse", "HEAD"),
    "dirty": bool(git("status", "--porcelain")),
    "extBin": ext_bin,
    "appBin": app_bin,
    "localSourceManifest": source,
    "localBuildFingerprint": build,
}, open(out_path, "w"), indent=2)
PY
"$NOW/tools/image-provenance" "$BASE" --label "spin-up-ppc base" \
    --staged-json "$STAGED_JSON" \
    --json "$RUN/provenance.json" --md "$RUN/provenance.md" || true

# --- free ports, not assumed ones ---------------------------------------
# ANCHOR forwards to the base image's baked worker on guest 1400 (the
# deploy channel). WIRE is where NOW's own wire lands: the guest DIALS
# 10.0.2.2:5250 by default (prefs.c set_defaults, contract 5250), and
# 10.0.2.2 under user-mode networking IS this Mac's loopback, so the
# listener binds it directly and no forward is involved.
port_free () { ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
ANCHOR="${NOW_ANCHOR_PORT:-1700}"
if [ -z "${NOW_ANCHOR_PORT:-}" ]; then
    tries=0
    while ! port_free "$ANCHOR"; do
        ANCHOR=$((ANCHOR + 2)); tries=$((tries + 1))
        [ "$tries" -gt 30 ] && { echo "no free anchor port"; exit 1; }
    done
elif ! port_free "$ANCHOR"; then
    echo "requested anchor port $ANCHOR is in use (another session?)"; exit 1
fi
WIRE="${NOW_WIRE_PORT:-5250}"
# NOW_SPIN_RESTRICT=1 isolates the guest from every host listener
# (slirp restrict=on): its dial to 10.0.2.2:5250 fails exactly as it
# does on hardware with no host up, while the anchor hostfwd still
# reaches in. This is the mode for UI work while a HUMAN's host app
# holds 5250 — without it the guest walks into their session, which is
# the same collision class the metal rules exist for. The wire verify
# phase is skipped: nothing can dial us, so listening would only hang.
RESTRICT="${NOW_SPIN_RESTRICT:-0}"
if [ "$RESTRICT" = "1" ]; then
    echo "restricted: the guest can reach nothing on this Mac"
else
    port_free "$WIRE" || { echo "port $WIRE is already listening — another NOW host \
is up, and the guest's compiled-in default would dial IT, not us"; exit 1; }
fi
HOSTFWD="hostfwd=tcp:127.0.0.1:${ANCHOR}-:1400"
[ "$RESTRICT" = "1" ] && HOSTFWD="restrict=on,$HOSTFWD"
printf '%s %s\n' "$ANCHOR" "$WIRE" > "$RUN/ports"
echo "ports: anchor=$ANCHOR wire=$WIRE"

# A window a person will look at comes from tbt_human_display, not from a
# backend spelled here: cocoa shears under the pointer and SDL is what fixed
# it (docs/05-qemu-field-notes.md in the lab checkout). lib.sh rescues a bare
# "cocoa" anyway, but a caller should not need rescuing.
# The fallback is not decoration: this repo and the lab checkout are versioned
# apart, so a lab that predates tbt_human_display would otherwise leave
# -display empty under set -e and take the boot down with it.
DISPLAY_KIND=none
[ "${NOW_SPIN_DISPLAY:-0}" = "1" ] \
    && DISPLAY_KIND="$(tbt_human_display 2>/dev/null || printf 'sdl')"
[ "${NOW_DIRECT_INPUT_ONLY:-0}" != "1" ] || [ "$DISPLAY_KIND" != none ] || {
    echo "NOW_DIRECT_INPUT_ONLY=1 requires NOW_SPIN_DISPLAY=1" >&2
    exit 64
}

boot () {   # $1 = fresh | cold
    [ "$1" = fresh ] && tbt_clone_disk "$BASE" "$DISK"
    TIMBOTTU_QEMU="$QEMU" tbt_qemu_boot "NOW spin-up" "$DISPLAY_KIND" "$DISK" \
        "$HOSTFWD" "" "$QMP" "$RUN/qemu.pid" "$RUN/qemu.log"
}

# Poll the anchor with a real hello. This deliberately NEVER dismisses a boot
# modal with QMP input. Doing so hid dirty base images and dirty staging reboots
# behind a green readiness result. A visible direct-input run may let a person
# diagnose and dismiss an already-dirty base; a headless run times out and
# leaves the machine visible through its QMP screendump evidence.
wait_anchor () {
    python3 - "$QMP" "$ANCHOR" "$LAB" "${NOW_DIRECT_INPUT_ONLY:-0}" <<'PY'
import sys, time
qmp, anchor, lab, direct_input_only = (
    sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4] == "1"
)
sys.path.insert(0, f"{lab}/mcp-classic")
from timbottu_mcp_classic.harness import Harness
t0 = time.time()
while time.time() - t0 < 300:
    try:
        if Harness(host="127.0.0.1", port=anchor,
                   expect_backing={"worker"}).request("hello", {}).get("policyDigest"):
            print(f"anchor ready ({int(time.time()-t0)}s)"); sys.exit(0)
    except Exception:
        pass
    time.sleep(6)
mode = "visible direct-input run" if direct_input_only else "headless run"
sys.exit(f"anchor timeout ({mode}); inspect a QMP screendump for a dirty-image "
         "or other boot modal — readiness never dismisses one")
PY
}

echo "== boot a fresh, session-private clone =="
boot fresh; wait_anchor

echo "== stage the extension, the app and the shutdown applet =="
NOW_ANCHOR_PORT="$ANCHOR" NOW_EXT_BIN="$EXT_BIN" NOW_APP_BIN="$APP_BIN" \
    NOW_SHUTDOWN_BIN="$SHUTDOWN_BIN" \
    python3 "$NOW/tools/stage-ext.py"

# Rule 1. The Macintosh, not QEMU, owns the volume-clean transition — and
# it owns it from inside, because nothing outside can reach its interface:
# QMP keyboard events do not arrive on mac99 (`has-adb=false`, so no ADB
# keyboard and no power key), there is no absolute pointing device, and a
# posted click cannot select from a menu. So the applet staged above calls
# the Shutdown Manager, and shutdown-guest.py waits for QEMU to exit. If it
# will not go, STOP with the VM intact: falling back to `quit` would
# manufacture the very Disk First Aid boot this gate exists to avoid.
echo "== guest-clean shutdown, then COLD boot so the INIT loads =="
python3 "$NOW/tools/shutdown-guest.py" "$QMP" --port "$ANCHOR" \
    --timeout "${NOW_SHUTDOWN_WAIT:-120}" || {
        echo "clean shutdown failed; VM left running at $QMP" >&2
        exit 1
    }
sleep 2
boot cold; wait_anchor

echo "== did the staged files survive the reboot? =="
# NOW_EXT_NAME is honoured HERE too, not just at the stage step. It was
# not, and the omission broke the one workflow the charter actually
# prescribes for resident work: a dev build goes up as its OWN throwaway
# INIT under its own name (docs/resident-components.md), and this check
# then looked for "NOW Extension", did not find it, and reported the
# staged file GONE AFTER THE REBOOT - which reads as a flush that never
# landed, on a run where every byte arrived under the name it was asked
# for. The scariest sentence this script can print, for the safest thing
# a person can do.
python3 - "$ANCHOR" "$LAB" "${NOW_EXT_NAME:-NOW Extension}" <<'PY'
import sys
anchor, lab, ext_name = int(sys.argv[1]), sys.argv[2], sys.argv[3]
sys.path.insert(0, f"{lab}/mcp-classic")
from timbottu_mcp_classic.harness import Harness
h = Harness(host="127.0.0.1", port=anchor, expect_backing={"worker"})
for path in (f"Macintosh HD:System Folder:Extensions:{ext_name}",
             "Macintosh HD:TimBotTu:now-dev:New Old World"):
    st = h.request("stat", {"path": path})
    if not st.get("exists"):
        sys.exit(f"{path} is GONE after the reboot — the write never flushed")
    print(f"  {path.split(':')[-1]}: type={st.get('type')} "
          f"creator={st.get('creator')} data={st.get('dataSize')} "
          f"rsrc={st.get('rsrcSize')}")
PY

# The file surviving is NOT proof the INIT loaded — that is the whole point
# of the next step. The guest is the oracle: `qdtrace op=status` reports the
# content plane, which exists only if the extension published its table
# through Gestalt 'NWex' at boot.
echo "== launch NOW and ask the GUEST whether the extension is live =="
python3 - "$ANCHOR" "$LAB" <<'PY'
import sys
anchor, lab = int(sys.argv[1]), sys.argv[2]
sys.path.insert(0, f"{lab}/mcp-classic")
from timbottu_mcp_classic.harness import Harness
Harness(host="127.0.0.1", port=anchor, expect_backing={"worker"}).request(
    "launch", {"path": "Macintosh HD:TimBotTu:now-dev:New Old World"})
print("  launch requested")
PY

# THE GATE. `mirror` is the guest's own lifecycle view of the resident —
# `lifecycle`, the build fingerprint, the capability word and one row per
# plane — and it answers the only question this script exists to ask: did
# the INIT load? `qdtrace op=status` is the content plane saying the same
# thing from the other side, through a Gestalt block an application that
# found nothing could not invent.
#
# --retries because the guest has just been launched and the first answer
# after a launch is not always its settled one.
if [ "$RESTRICT" = "1" ]; then
    echo "== restricted run: the guest cannot dial, skipping the wire verify =="
    rc=0
else
    set +e
    # Tee'd rather than just printed: the guest's OWN account of the
    # resident is the strongest line in a rig table, and it was being
    # written to a terminal and lost. It goes into the run's provenance so
    # a report can quote it from a file.
    python3 "$NOW/tools/askguest.py" --port "$WIRE" --wait "${NOW_DIAL_WAIT:-180}" \
        --retries 3 --retry-delay 6 \
        mirror qdtrace:op=status 2>&1 | tee "$RUN/mirror.txt"
    rc=${PIPESTATUS[0]}
    set -e
fi

# Re-write the provenance now that the guest has spoken. Before this point
# the block says what we STAGED; after it, what the machine says it is
# running — which is the only claim worth quoting, and the difference
# between the two is a staging failure this rig exists to catch.
if [ -f "$RUN/mirror.txt" ]; then
    python3 - "$RUN/mirror.txt" "$RUN/staged.json" <<'PY' || true
import json, sys
raw, staged_path = sys.argv[1:3]
found = None
for line in open(raw, errors="replace"):
    line = line.strip()
    if line[:3] in ("-> ", "<- "):
        line = line[3:]
    if not line.startswith("{"):
        continue
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    ext = msg.get("output", {}).get("mirror", {}).get("extension")
    if ext:
        found = ext
if found:
    staged = json.load(open(staged_path))
    staged["residentReported"] = found
    json.dump(staged, open(staged_path, "w"), indent=2)
PY
    "$NOW/tools/image-provenance" "$BASE" --label "spin-up-ppc base" \
        --staged-json "$RUN/staged.json" \
        --json "$RUN/provenance.json" --md "$RUN/provenance.md" || true
fi

# NOT the gate, deliberately, and this is the honest half of the run.
# `actselftest` is the act plane's only ABI oracle, and on 2026-08-05 — the
# first cold boot that ever got this far, because until then the shutdown
# could not complete — it answered `no-such-process` on every attempt over
# minutes, with `axsnap` reporting `bind: no-plane` while `mirror` reported
# the very same planes `requested: 5, active: 5`. That is a real defect in
# the anchor-bind path and it is NOT this rig: gating on it would make
# spin-up-ppc permanently red for something it does not cause and cannot
# fix, which is how a gate stops being read. So it runs, it prints, and it
# is written down (docs/open-issues.md). When the bind path is repaired,
# this moves back into the gate above.
echo
echo "== probe, not the gate: the act plane's ABI oracle =="
python3 "$NOW/tools/askguest.py" --port "$WIRE" --wait "${NOW_PROBE_WAIT:-90}" \
    axsnap actselftest || echo "  ^ known, and not the staging path: see \
docs/open-issues.md, the anchor-bind entry. The run's verdict is above."

echo
echo "== the rig, for whatever report quotes this run =="
echo "   $RUN/provenance.md    (paste-ready rig table)"
echo "   $RUN/provenance.json  (the same facts, machine-readable)"
echo "A measurement with no rig table beside it is a number nobody can"
echo "attribute later — this run's is written, so copy it rather than"
echo "remembering which image was involved."
echo

echo "anchor=127.0.0.1:$ANCHOR  wire=127.0.0.1:$WIRE  qmp=$QMP"
echo "stop:  $NOW/tools/shutdown-guest.py $QMP --port $ANCHOR"
echo "       # quits the front application, then launches the staged"
echo "       # applet so the guest shuts ITSELF down. Leaves the VM up on"
echo "       # failure, and never QMP \`quit\` — that is a power cut, and"
echo "       # the next boot spends its first minutes in Disk First Aid."
echo "       ...and never by PORT. \`lsof -ti tcp:$WIRE\` matches QEMU:"
echo "       under user-mode networking the GUEST's outbound connection"
echo "       belongs to the qemu process, so killing what holds the wire"
echo "       port kills the whole machine. Done by accident 2026-08-03."
exit $rc
