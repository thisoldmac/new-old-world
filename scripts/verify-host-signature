#!/bin/sh
set -eu

expected_team=B93A9CG7F9

profile=canonical
if [ "${1:-}" = "--profile" ]; then
    [ "$#" -ge 2 ] || { echo "--profile requires a value" >&2; exit 64; }
    profile=$2
    shift 2
fi

if [ "$#" -ne 1 ]; then
    echo "usage: $0 [--profile canonical|continuity] /absolute/path/app" >&2
    exit 64
fi

bundle=$1
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
identity="$(dirname "$script_dir")/tools/host-build-identity"
expected_bundle=$($identity "$profile" bundle-id)
expected_display=$($identity "$profile" display-name)
codesign --verify --strict "$bundle"

details=$(codesign -dvv "$bundle" 2>&1)
team=$(printf '%s\n' "$details" | sed -n 's/^TeamIdentifier=//p')
if [ "$team" != "$expected_team" ]; then
    echo "host app is not signed by expected team $expected_team (got ${team:-none})" >&2
    exit 70
fi

entitlements=$(mktemp "${TMPDIR:-/tmp}/now-host-entitlements.XXXXXX")
cleanup() { rm -f "$entitlements"; }
trap cleanup EXIT INT TERM
codesign -d --entitlements :- "$bundle" > "$entitlements" 2>/dev/null

application_id=$(/usr/libexec/PlistBuddy \
    -c 'Print :com.apple.application-identifier' \
    "$entitlements" 2>/dev/null || true)
keychain_group=$(/usr/libexec/PlistBuddy \
    -c 'Print :keychain-access-groups:0' "$entitlements" 2>/dev/null || true)
expected_id="$expected_team.$expected_bundle"

if [ "$application_id" != "$expected_id" ]; then
    echo "host app has wrong application identifier (got ${application_id:-none})" >&2
    exit 70
fi
if [ "$keychain_group" != "$expected_id" ]; then
    echo "host app has wrong Keychain access group (got ${keychain_group:-none})" >&2
    exit 70
fi

info="$bundle/Contents/Info.plist"
actual_bundle=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$info")
actual_display=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$info")
local_network=$(/usr/libexec/PlistBuddy \
    -c 'Print :NSLocalNetworkUsageDescription' "$info" 2>/dev/null || true)

if [ "$actual_bundle" != "$expected_bundle" ]; then
    echo "host app plist has wrong bundle identifier (got $actual_bundle)" >&2
    exit 70
fi
if [ "$actual_display" != "$expected_display" ]; then
    echo "host app plist has wrong display name (got $actual_display)" >&2
    exit 70
fi
if [ -z "$local_network" ]; then
    echo "host app lacks NSLocalNetworkUsageDescription" >&2
    exit 70
fi
bonjour=$(/usr/libexec/PlistBuddy \
    -c 'Print :NSBonjourServices:0' "$info" 2>/dev/null || true)
if [ "$bonjour" != _newoldworld._tcp ]; then
    echo "host app lacks the app-owned Bonjour permission prompt service " \
         "(got ${bonjour:-none})" >&2
    exit 70
fi

executable=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$info")
uuid_count=$(dwarfdump --uuid "$bundle/Contents/MacOS/$executable" \
    2>/dev/null | wc -l | tr -d ' ')
if [ "$uuid_count" -ne 1 ]; then
    echo "host main executable must carry exactly one UUID for Local Network " \
         "privacy tracking (got $uuid_count)" >&2
    exit 70
fi
