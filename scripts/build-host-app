#!/bin/sh
set -eu

signing=developer
profile=canonical
while [ "$#" -gt 0 ]; do
    case "$1" in
        --adhoc) signing=adhoc; shift ;;
        --unsigned-release) signing=unsigned-release; shift ;;
        --profile)
            [ "$#" -ge 2 ] || {
                echo "--profile requires canonical or continuity" >&2
                exit 64
            }
            profile=$2
            shift 2
            ;;
        --) shift; break ;;
        -*) echo "unknown option: $1" >&2; exit 64 ;;
        *) break ;;
    esac
done

if [ "$#" -gt 1 ]; then
    echo "usage: $0 [--adhoc|--unsigned-release] [--profile canonical|continuity] [output directory]" >&2
    exit 64
fi

# These used to let every candidate mint a new macOS privacy identity. Refuse
# them even when their value happens to match: the supported choice is a
# named, reviewed profile whose Team ID and plist are verified after signing.
if [ "${NOW_HOST_BUNDLE_IDENTIFIER+x}" = x ] \
        || [ "${NOW_HOST_DISPLAY_NAME+x}" = x ]; then
    echo "NOW_HOST_BUNDLE_IDENTIFIER/NOW_HOST_DISPLAY_NAME are unsupported; use --profile canonical|continuity" >&2
    exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname "$script_dir")

# Default into the checkout's own build tree, the way scripts/build-bundle
# and the Makefile do. `build/` is gitignored and per-worktree, which is what
# it is for; an out-of-tree path stays available for a run that wants a
# stable bundle path (per-binary Local Network and Accessibility grants
# follow the path, so a lane that keeps its grants passes one).
output_root=${1:-$repo_root/build/host-app}

if [ "$output_root" = / ]; then
    echo "output directory must not be the filesystem root" >&2
    exit 64
fi

mkdir -p "$output_root"
output_root=$(CDPATH= cd -- "$output_root" && pwd -P)

if [ "$output_root" = "$repo_root" ]; then
    echo "output directory must not be the repository root" >&2
    exit 64
fi

if [ "$signing" = developer ] && [ "$profile" = continuity ]; then
    "$repo_root/tools/host-handoff-path" "$output_root"
    "$repo_root/tools/continuity-stack-gate" source >/dev/null
fi

identity="$repo_root/tools/host-build-identity"
bundle_identifier=$($identity "$profile" bundle-id)
display_name=$($identity "$profile" display-name)
bundle_name=$($identity "$profile" bundle-name)
bundle="$output_root/$bundle_name"

# A MONOTONIC BUILD NUMBER, because every build claiming CFBundleVersion 1
# left LaunchServices and the Local Network daemon unable to tell an update
# from a duplicate - and per-binary grants (Local Network, Accessibility)
# were lost on every install (attended, 2026-08-17). The commit count moves
# with every landing; the marketing version stays the release's own.
build_number=$(git -C "$repo_root" rev-list --count HEAD 2>/dev/null || echo 1)

if [ "$signing" = developer ] || [ "$signing" = unsigned-release ]; then
    rm -rf "$bundle"
    configuration=Debug
    signing_args=""
    if [ "$signing" = unsigned-release ]; then
        configuration=Release
        signing_args="CODE_SIGNING_ALLOWED=NO"
    fi
    # shellcheck disable=SC2086 -- one optional xcodebuild assignment
    xcodebuild \
        -project "$repo_root/now-host/NewOldWorld.xcodeproj" \
        -scheme "New Old World" \
        -configuration "$configuration" \
        -derivedDataPath "$output_root/xcode-derived" \
        -allowProvisioningUpdates \
        DEVELOPMENT_TEAM=B93A9CG7F9 \
        CONFIGURATION_BUILD_DIR="$output_root" \
        PRODUCT_BUNDLE_IDENTIFIER="$bundle_identifier" \
        NOW_PRODUCT_NAME="$display_name" \
        NOW_DISPLAY_NAME="$display_name" \
        CURRENT_PROJECT_VERSION="$build_number" \
        $signing_args \
        build
    if [ "$signing" = developer ]; then
        "$script_dir/verify-host-signature" --profile "$profile" "$bundle"
    fi
else
    scratch="$output_root/swift-build"
    binary="$scratch/debug/Host"

    swift build --package-path "$repo_root/now-host" --scratch-path "$scratch"
    rm -rf "$bundle"
    mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
    cp "$binary" "$bundle/Contents/MacOS/Host"

    # SwiftPM puts target resources in bundles beside the binary. An ad-hoc
    # package build that omits them launches successfully and then traps the
    # first time Bundle.module is touched, so refuse to stage that shape.
    found=0
    for res in "$scratch"/debug/*.bundle; do
        [ -e "$res" ] || continue
        case "$res" in *Tests.bundle) continue ;; esac
        rm -rf "$bundle/Contents/Resources/$(basename "$res")"
        cp -R "$res" "$bundle/Contents/Resources/"
        found=$((found + 1))
    done
    if [ "$found" -eq 0 ]; then
        echo "no resource bundles found beside the binary - refusing to stage" \
             "an app that would trap on its first resource" >&2
        exit 70
    fi

    sed \
        -e "s/@DISPLAY_NAME@/$display_name/g" \
        -e "s/@BUNDLE_ID@/$bundle_identifier/g" \
        "$script_dir/HostInfo.plist.in" > "$bundle/Contents/Info.plist"
    "$script_dir/stage-now-cli" "$bundle"
    codesign --force --sign - "$bundle"
fi

echo "$bundle"
