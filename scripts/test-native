#!/bin/sh
# Compile and run every native (host-compiler) test both guests carry.
#
# The guests cannot run their own test suites - one is a PowerPC Carbon
# application and the other a 68K application, and neither machine is where
# anyone iterates. So the pure-C halves of each are compiled by the HOST cc
# and run here, which is the only automated feedback either guest has short
# of a real Macintosh. Until this script existed, running them meant copying
# a cc line out of each test's header comment by hand, which meant in
# practice that nobody ran the ones they were not already editing.
#
#     scripts/test-native            # everything
#     scripts/test-native frame      # only tests whose name matches "frame"
#
# Binaries are written OUTSIDE the repository (TMPDIR), because a build
# artifact that lands in a worktree eventually lands in a commit.
#
# THE MANIFEST IS THE POINT. Each test names its own sources below, and the
# last check in this file fails if a test file exists that the manifest does
# not list. A test nobody runs is worse than no test - it reads as coverage
# in a directory listing and proves nothing - so a new one cannot be added
# silently. If you add a test, add its line here and watch it run.
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname "$script_dir")
filter=${1:-}

out_root=${TMPDIR:-/tmp}/now-native-tests.$$
mkdir -p "$out_root"
trap 'rm -rf "$out_root"' EXIT INT TERM

# The gate the guests were developed under. -Werror is not decoration here:
# now-guest-68k's CMakeLists records that one of its real bugs was caught by
# -Werror alone, so a runner that dropped it would be a weaker gate than the
# comment lines it replaced.
CFLAGS="-Wall -Wextra -Werror"

passed=0
failed=0
skipped=0
failures=""

# run_c <dir> <test.c> <extra-cc-flags> <sources...>
run_c() {
    dir=$1; test_src=$2; extra=$3
    shift 3
    name=$(basename "$test_src" .c)

    case "$name" in
        *"$filter"*) ;;
        *) skipped=$((skipped + 1)); return 0 ;;
    esac

    srcs=""
    for s in "$@"; do
        srcs="$srcs $repo_root/$dir/$s"
    done

    printf '%-28s ' "$name"
    # Every domain directory under src/ is on the include path, not just
    # src/ itself. The guests include their headers by bare name
    # ("json.h", "frame.h") from wherever they sit, so the domain split is
    # a filing decision the compiler never has to know about - and this
    # loop picks up a NEW domain directory without an edit here, which is
    # the difference between a layout change costing one commit and
    # costing one commit plus a confusing build failure.
    incs="-I $repo_root/contract -I $repo_root/now-guest-shared/src"
    for d in "$repo_root/$dir/src" "$repo_root/$dir/src"/*/; do
        [ -d "$d" ] && incs="$incs -I $d"
    done
    # contract/ is on every guest test's include path, the way it is on
    # every guest's: the shared headers there (wire_limits.h,
    # share_path.h, peek_table.h) are compiled by both guests and by this
    # host cc, and adding the flag per line meant four tests failing to
    # build the first time a guest header included one. now-guest-shared/src
    # is there for the same reason and with the same history: it holds the
    # console history BOTH guests compile, so a test of either guest's
    # console can reach it without a per-line flag.
    # shellcheck disable=SC2086 - extra, incs and srcs are deliberately split
    if ! cc $CFLAGS $extra $incs \
            "$repo_root/$dir/tests/$test_src" $srcs \
            -o "$out_root/$name" > "$out_root/$name.build" 2>&1; then
        echo "BUILD FAILED"
        cat "$out_root/$name.build"
        failed=$((failed + 1)); failures="$failures $name(build)"
        return 0
    fi
    if ! "$out_root/$name" > "$out_root/$name.run" 2>&1; then
        echo "FAILED"
        cat "$out_root/$name.run"
        failed=$((failed + 1)); failures="$failures $name"
        return 0
    fi
    echo "ok"
    passed=$((passed + 1))
}

run_py() {
    dir=$1; test_src=$2
    name=$(basename "$test_src" .py)
    case "$name" in
        *"$filter"*) ;;
        *) skipped=$((skipped + 1)); return 0 ;;
    esac
    printf '%-28s ' "$name"
    if ! (cd "$repo_root/$dir/tests" && python3 "$test_src") \
            > "$out_root/$name.run" 2>&1; then
        echo "FAILED"
        cat "$out_root/$name.run"
        failed=$((failed + 1)); failures="$failures $name"
        return 0
    fi
    echo "ok"
    passed=$((passed + 1))
}

# Compiled by BOTH guests, so it belongs to neither's section. The one
# extra -I is the point of the test: it reads the PowerPC console page's
# own input width from console_model.h rather than copying the number, so
# a history narrower than the field it serves fails here.
echo "== now-guest-shared (both guests compile these) =="
run_c now-guest-shared console_history_test.c \
      "-I $repo_root/now-guest-ppc/src/console"  src/console_history.c
# The act plane's guard (P4), compiled by the 68K extension AND the
# PowerPC application, so it belongs to neither's section either. It is
# the ONE thing in the port a host can check that matters: the guard is
# what separates "the request drove the element it named" from "the
# patch rode the user's own click", and upstream measured that gap at
# 18/20 against 0/20. The resident half it serves runs inside every
# process that pumps events, which is the worst place in this project to
# discover a comparison was backwards.
run_c now-guest-shared now_act_guard_test.c \
      "-DNOW_PEEK_TABLE_HOST"  src/now_act_guard.c
# The six trap trampolines' result-slot ABI, read out of the assembly.
# A source test, and normally the weakest kind - but a Pascal Boolean
# answered as 0x0001 writes FALSE while the patch reports firing, and
# every instrument on our side agrees with it. That failure cannot be
# executed here and must not be left to a comment.
run_py now-guest-shared act_patch_abi_source_test.py

echo "== now-guest-ppc (PowerPC Carbon) =="
run_c now-guest-ppc census_decode_test.c     ""  src/census/census_decode.c
run_c now-guest-ppc census_report_test.c     ""  src/census/census_report.c src/core/json.c
run_c now-guest-ppc conn_fields_test.c       ""  src/connection/conn_fields.c
run_c now-guest-ppc diag_layout_test.c       ""  src/diagnostics/diag_layout.c
run_c now-guest-ppc mcp_layout_test.c        ""  src/mcp/mcp_layout.c
run_c now-guest-ppc json_native_test.c       ""  src/core/json.c
run_c now-guest-ppc peek_table_test.c \
      "-DNOW_PEEK_TABLE_HOST"
run_c now-guest-ppc peek_validate_test.c     ""  src/peek/peek_validate.c
# The content plane (P3) - the extension's QuickDraw hooks. Its SOURCE
# lives under ext/src, not under a guest, because it is resident 68K code;
# the decisions it makes before it touches anything are split into a
# Toolbox-free file so this host cc can execute them. That split is the
# only reason draw-time resident code has any automated gate at all, and
# the arm verdict in particular is the plane's whole safety story.
run_c now-guest-ppc content_plane_test.c \
      "-DNOW_PEEK_TABLE_HOST -I $repo_root/ext/src" \
      ../ext/src/now_content_logic.c
run_c now-guest-ppc peek_oracle_test.c \
      "-DNOW_PEEK_TABLE_HOST" src/peek/peek_oracle.c src/peek/peek_validate.c
# The scene envelope's Toolbox-free halves. Assembly is where the anchor
# verdicts become claims about the machine, and the encoder is where an
# unproduced plane is an ABSENT key rather than an empty one - both are
# reachable here for the same reason peek_oracle.c is.
run_c now-guest-ppc scene_build_test.c       ""  src/scene/scene_build.c
run_c now-guest-ppc scene_json_test.c        ""  src/scene/scene_build.c \
      src/scene/scene_json.c src/core/json.c
# The bridge between the ported walk and the scene's rules - the layer
# the roadmap called "the ported walk has no caller". It is Toolbox-free
# on purpose (it takes a bound memory seam as an argument), so the
# decisions that turn a parser result into a CLAIM are reachable here,
# against the same synthetic arena the axwalk tests use.
run_c now-guest-ppc scene_walk_test.c        ""  src/scene/scene_walk.c \
      src/scene/scene_build.c src/axwalk/axwalk.c src/axwalk/axmenu.c \
      src/axwalk/axtext.c src/peek/peek_validate.c
# The ported foreign-memory walk (src/axwalk/, from timbottu/mirror). The
# first automated coverage this archaeology has ever had: upstream proved
# the offsets on a real machine and had no host test, so these pin the
# numbers and exercise the boundary the walk refuses to cross.
run_c now-guest-ppc axwalk_test.c            ""  src/axwalk/axwalk.c \
      src/peek/peek_validate.c
# The Menu Manager layout in particular: its header size and entry stride
# are in NO header this toolchain ships, so before this test the only
# thing that could catch a wrong one was a Macintosh.
run_c now-guest-ppc axmenu_test.c            ""  src/axwalk/axmenu.c \
      src/axwalk/axwalk.c src/peek/peek_validate.c
run_c now-guest-ppc axtext_test.c            ""  src/axwalk/axtext.c \
      src/axwalk/axwalk.c src/peek/peek_validate.c
# The resolver's policy - occurrences, cycles, bounds, staleness - and
# the lifetime binding. Both are pure, and both cover cases a real
# machine cannot be asked to produce on demand.
run_c now-guest-ppc axresolve_test.c         ""  src/axwalk/axresolve.c \
      src/axwalk/axwalk.c src/peek/peek_validate.c
run_c now-guest-ppc axbinding_test.c         ""  src/axwalk/axbinding.c
# The reference layer every act verb addresses. Mirror measured that an
# act surface bounded by time or use count is not bounded (18/20
# hijacked) and one bounded by NAMING its target is (0/20), so what these
# two pin is mostly negative: that a token cannot be derived from
# anything observable, that an unminted one matches nothing, and that
# each way a reference can stop being true is refused DISTINCTLY rather
# than repaired. None of those cases can be produced on demand on a real
# machine - you cannot ask one to recycle a PSN at a chosen moment.
run_c now-guest-ppc obsref_test.c           ""  src/observe/obsref.c \
      src/axwalk/axresolve.c src/axwalk/axwalk.c src/peek/peek_validate.c
run_c now-guest-ppc obsresolve_test.c       ""  src/observe/obsresolve.c \
      src/observe/obsref.c src/axwalk/axresolve.c src/axwalk/axwalk.c \
      src/peek/peek_validate.c
# The act plane's application half, the two parts of it that decide
# anything. act_ref is why the plane cannot express "whatever is
# frontmost" - a reference is one this guest minted, and one whose
# element has MOVED is refused rather than resolved to the neighbour
# that answers to the same title. act_args is the same rule in
# miniature: an action takes exactly its own geometry keys.
run_c now-guest-ppc act_ref_test.c           ""  src/act/act_ref.c
run_c now-guest-ppc act_args_test.c          ""  src/act/act_args.c
run_c now-guest-ppc share_path_test.c        ""
# The Files pane's pull presentation: when Stop is armed, and the line a
# person reads while a file comes down. The percentage overflows a 32-bit
# long at 21.5 MB, which would otherwise be found by watching a download
# go negative two thirds of the way through.
run_c now-guest-ppc files_pull_test.c        ""  src/files/files_pull.c
run_c now-guest-ppc proc_quit_args_test.c    ""  src/processes/proc_quit_args.c
run_c now-guest-ppc processes_layout_test.c  ""  src/processes/processes_layout.c
run_c now-guest-ppc software_layout_test.c   ""  src/software/software_layout.c
run_c now-guest-ppc sw_vers_parse_test.c     ""  src/software/sw_vers_parse.c
run_c now-guest-ppc workshop_layout_test.c   ""  src/workshop/workshop_layout.c
run_c now-guest-ppc cmd_help_test.c         ""  src/commands/cmd_help.c
run_c now-guest-ppc cmd_line_test.c         ""  src/commands/cmd_line.c src/core/json.c
# The gestalt reply's serializer, driven at caps the real machine never
# reaches. See the test's header: the bug it pins could not have been found
# on hardware, because no machine answers enough selectors to overflow.
run_c now-guest-ppc gestalt_json_test.c     ""  src/commands/gestalt_json.c
# The input plane's decisions (mouseloc / script / aesend). Two of the
# hazards it guards have no error path once crossed: an `entire contents`
# Finder search wedged a real machine for twelve minutes, and a core Apple
# Event addressed at our own serial answers the caller with a dropped
# socket. Neither can be reported after the fact, so the refusal is the
# only chance and it gets watched failing here.
run_c now-guest-ppc input_args_test.c       ""  src/input/input_args.c
run_py now-guest-ppc ot_connect_source_test.py
# The other half of the Stop button, and the link teardown it shares a file
# with. wire.c does not compile on the host (g_get is private to it, and
# every path through it is Toolbox-bound), so what a host can check is what
# the source says: the cancel frame's shape, both halves in order, and one
# drop list rather than two that drift.
run_py now-guest-ppc get_cancel_source_test.py

# The probe harnesses (scripts/probes/, ported from timbottu/mirror/tests).
# Those harnesses drive a LIVE Macintosh and none of them can run here - but
# the arithmetic that turns trials into a number is pure, and it is the one
# defect that would poison every number they produce. tally.py holds it alone
# for exactly that reason. See the test's header for the mutations it has been
# watched to fail under.
echo "== scripts/probes (host-side, machineless half) =="
run_py scripts/probes tally_test.py

echo "== now-guest-68k (68K, System 7.1) =="
run_c now-guest-68k connfields_test.c  "-std=c99 -pedantic"  src/connection/connfields.c
run_c now-guest-68k test_console_ring.c "" src/console/n68_console_ring.c src/console/n68_linesplit.c
run_c now-guest-68k test_framecodec.c   "" src/core/frame.c src/core/hello.c src/core/ping.c \
      src/core/json_scan.c src/core/numfmt.c
run_c now-guest-68k test_reader.c       "" src/core/n68_reader.c src/core/frame.c
run_c now-guest-68k test_proclist.c     "" src/processes/n68_proclist.c src/core/numfmt.c
run_c now-guest-68k test_backpressure.c "" src/core/n68_reader.c src/core/frame.c
run_c now-guest-68k test_devsettings.c  "-std=c99 -pedantic"  src/connection/n68_devsettings.c \
      src/connection/connfields.c
run_c now-guest-68k test_cmdresult.c    "" src/commands/n68_cmdresult.c src/core/numfmt.c
run_c now-guest-68k test_vprobe.c       "" src/census/n68_vprobe.c src/commands/n68_cmdresult.c \
      src/core/numfmt.c
run_c now-guest-68k test_census.c      "" src/census/n68_census.c \
      src/commands/n68_cmdresult.c src/core/numfmt.c
run_c now-guest-68k test_shot.c         "" src/screenshots/n68_shot.c src/commands/n68_cmdresult.c \
      src/core/numfmt.c
run_c now-guest-68k test_shotwire.c     "" src/screenshots/n68_shotwire.c \
      src/screenshots/n68_packbits.c src/core/numfmt.c
# The framebuffer walk, over a synthetic screen with poisoned padding. The
# only automated cover the VRAM read has: vprobe times it, and a wrong base
# reads at full speed.
run_c now-guest-68k test_shotemit.c     "" src/screenshots/n68_shotwire.c \
      src/screenshots/n68_packbits.c src/core/numfmt.c
run_c now-guest-68k test_packbits.c     "" src/screenshots/n68_packbits.c
# The capture diagnostic's renderer. The Toolbox half (StripAddress, the
# MMU byte, the walk) is unreachable from here and is NOT covered; what is
# covered is the four verdicts and the exact width of a sample row.
run_c now-guest-68k test_shotdiag.c     "" src/screenshots/n68_shotdiag.c \
      src/commands/n68_cmdresult.c src/core/numfmt.c
run_c now-guest-68k test_crc32.c        "" src/core/n68_crc32.c
run_c now-guest-68k test_putrx.c        "" \
      src/files/n68_putrx.c src/core/n68_crc32.c src/core/json_scan.c
# The PowerPC guest's own quit-grammar test, compiled against THIS
# guest's copy of the parser. One test, two implementations - see the
# file's header for why it is an #include rather than a second copy.
run_c now-guest-68k proc_quit_parity_test.c "" src/processes/proc_quit_args.c src/core/numfmt.c
run_c now-guest-68k test_puttx.c        "" src/files/n68_puttx.c src/core/n68_crc32.c \
      src/commands/n68_cmdresult.c src/core/numfmt.c src/core/frame.c
run_c now-guest-68k test_filelist.c     "" src/files/n68_filelist.c src/commands/n68_cmdresult.c \
      src/core/numfmt.c
# The software family's Toolbox-free half: the domain vocabulary, the
# two-folder cursor split, the page bounds and the truncation vocabulary.
# The sweep itself (n68_swenum.c) is pure Toolbox and is NOT covered here.
run_c now-guest-68k test_swlist.c       "" src/software/n68_swlist.c \
      src/commands/n68_cmdresult.c src/core/numfmt.c

# Every test file must be in the manifest above. Grepping this script for the
# filename is crude and deliberate: it is the check that cannot itself go
# stale, because it reads the same text a human reads.
#
# Two things it cannot see, from the gate audit of 2026-07-31. It greps THIS
# FILE, comments included, so a basename mentioned in a comment satisfies it
# with no run_c line at all - the same defect that hollowed three gates in
# the Swift suite, one shell script over. And "$base" is a grep PATTERN, so a
# name is also satisfied by any line containing it as a substring. No
# basename currently sits only in a comment (checked), which is the whole
# reason this is a note and not a fix: the loophole is open and unused, and
# closing it properly means a manifest this script parses rather than greps.
echo "== manifest =="
unlisted=""
for f in "$repo_root"/now-guest-ppc/tests/* "$repo_root"/now-guest-68k/tests/* \
         "$repo_root"/now-guest-shared/tests/* "$repo_root"/scripts/probes/tests/*; do
    case "$f" in *.c|*.py) ;; *) continue ;; esac
    base=$(basename "$f")
    grep -q -- "$base" "$0" || unlisted="$unlisted $base"
done
if [ -n "$unlisted" ]; then
    echo "test files not in the manifest:$unlisted"
    echo "add them to scripts/test-native and watch them run."
    failed=$((failed + 1)); failures="$failures manifest"
else
    echo "every test file is listed"
fi

echo
echo "$passed passed, $failed failed, $skipped not selected"
if [ "$failed" -ne 0 ]; then
    echo "failed:$failures"
    exit 1
fi
