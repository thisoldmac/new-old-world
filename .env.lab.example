# NOW lab configuration - copy to .env.lab, which is gitignored.
#
#     cp .env.lab.example .env.lab
#
# Nothing in here belongs in a commit: every value describes ONE desk.
# scripts/deploy-68k reads this file, and an explicit environment variable
# still wins over it, so a one-off run against another machine needs no
# edit. See docs/lab-setup.md for what each key is for.

# --- The 68K Mac (NOW-68K's target) ------------------------------------
# Its address, and the FTP account NetPresenz or Rumpus answers on.
NOW68K_FTP_HOST=192.0.2.10
NOW68K_FTP_USER=changeme
NOW68K_FTP_PASS=changeme
# Folder on that Mac where NOW-68K builds land. Relative to the FTP root.
NOW68K_FTP_DIR=Lab/now-68k

# THIS Mac's address, as the guest must dial it. Not localhost and not
# 10.0.2.2 - the guest is a separate machine on the LAN, and the QEMU
# gateway address never answers on real hardware while looking exactly
# like a hang.
NOW68K_HARNESS_HOST=192.0.2.2

# --- Toolchains --------------------------------------------------------
# The toolchain FILE in each case, not its directory. Both are optional:
# without them scripts/build-guests skips rather than fails, because a
# contributor with no Retro68 install is not failing a gate they cannot
# run. Everything else in this project still works.
NOW68K_TOOLCHAIN=/path/to/Retro68-build-68k/toolchain/m68k-apple-macos/cmake/retro68.toolchain.cmake
NOW_PPC_TOOLCHAIN=/path/to/Retro68-build/toolchain/powerpc-apple-macos/cmake/retrocarbon.toolchain.cmake

# --- The Quadra 800 emulator (scripts/q800-68k) ------------------------
# A 68040 under Mac OS 8.1 is not the PowerBook 180c, and nothing about
# timing or memory pressure carries over - but correctness does, and it is
# far cheaper to find a bug here than at the machine.
NOW_Q800_QEMU=/path/to/qemu-system-m68k
NOW_Q800_ROM=/path/to/Quadra800.rom
NOW_Q800_IMG=/path/to/os81-target.img
NOW_HFSUTILS=/path/to/hfsutils

# --- Metal gates -------------------------------------------------------
# Only read when NOW_METAL is set. NOW_METAL_MACHINE is what lets
# MetalMachineGuard check that nothing else on this Mac is already
# talking to the vintage machine; without it, half the guard cannot run
# and it says so rather than passing quietly.
# NOW_METAL=1
# NOW_METAL_PORT=5252
# NOW_METAL_MACHINE=192.0.2.10
# NOW_METAL_REPEATS=3
